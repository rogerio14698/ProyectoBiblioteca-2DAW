<file path="public/css/paneles/Invitado/paginaPrincipal.css">
/*********ESTILOS DE LA PAGINA PRINCIPAL DEL PANEL DE INVITADO**********/
.bienvenida {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 40vh;
    text-align: center;
    background-color: var(--color-blanco);
    padding: 10px;
    box-sizing: border-box;
}

.bienvenida .carousel {
    width: 100%;
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr) 56px;
    grid-template-areas:
    /*Esto da columnas independientes a los botones para avanzar en los slides del carrusel*/
        "prev contenido next"
        "prev indicadores next";
    align-items: center;
    column-gap: 0;
    margin: 0 auto;
}

.bienvenida .carousel-inner {
    grid-area: contenido;
    width: 100%;
}

.bienvenida .carousel-item {
    padding: calc(var(--unidad-espaciado) * 2) 0;
}


.bienvenidaSlideContenido {
    width: 100%;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    row-gap: calc(var(--unidad-espaciado) * 3);
    column-gap: calc(var(--unidad-espaciado) * 4);
    justify-content: center;
}

.bienvenidaSlideContenido > .tituloPagina,
.bienvenidaSlideContenido > .bienvenidaTitulo,
.bienvenidaSlideContenido > .bienvenidaParrafo,
.bienvenidaSlideContenido > .btn-base {
    grid-column: 1;
    text-align: left;
}

.bienvenidaSlideContenido > .bienvenida-imagen {
    grid-column: 2;
    grid-row: 1 / span 3;
    width: 100%;
    /* Altura fija para que ninguna imagen deforme el contenedor del slide */
    max-height: 420px;
    overflow: hidden;
    border-radius: var(--radio-borde);
}

.bienvenidaSlideContenido > .btn-base {
    width: 100%;
    justify-content: center;
}

.bienvenida-slides {
    margin-bottom: 20px;
    padding: 5px;
    text-align: justify;
    hyphens: auto;
}

.bienvenida-imagen img {
    width: 100%;
    max-width: 680px;
    /* Altura fija + object-fit:cover recorta la imagen al centro sin deformarla */
    height: 420px;
    object-fit: cover;
    margin: 0 0 0 auto;
    box-shadow: var(--sombra-media);
    border: 1px solid var(--colorBorde);
}

.bienvenida .carousel-indicators [data-bs-target] {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    margin: 0 6px;
    opacity: 1;
    border: 0;
    background-color: var(--colorComplementarioTerciario);
}

.bienvenida .carousel-indicators .active {
    background-color: var(--colorComplementarioSecundario);
}

.bienvenida .carousel-indicators {
    grid-area: indicadores;
    position: static;
    margin: calc(var(--unidad-espaciado) * 1.5) 0 0 0;
}

.bienvenida .carousel-control-prev,
.bienvenida .carousel-control-next {
    position: static;
    left: auto;
    right: auto;
    transform: none;
    width: 100%;
    height: 100%;
    opacity: 1;
    display: flex;
    align-items: center;
}

.bienvenida .carousel-control-prev {
    grid-area: prev;
    justify-content: center;
}

.bienvenida .carousel-control-next {
    grid-area: next;
    justify-content: center;
}

.bienvenida .carousel-control-prev-icon,
.bienvenida .carousel-control-next-icon {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background-color: var(--bgBtnVerde);
    box-shadow: var(--sombra-suave);
    background-size: 55% 55%;
}

@media (max-width: 991.98px) {
    .bienvenida {
        padding: var(--relleno-movil);
    }

    .bienvenida .carousel {
        grid-template-columns: 44px minmax(0, 1fr) 44px;
        column-gap: 0;
    }

    .bienvenida .carousel-item {
        min-height: auto;
        padding: var(--relleno-movil);
    }

    .bienvenidaSlideContenido {
        grid-template-columns: 1fr;
        gap: calc(var(--unidad-espaciado) * 2);
    }

    .bienvenidaSlideContenido > .bienvenida-imagen {
        grid-column: 1;
        grid-row: auto;
        /* En móvil la imagen ocupa menos alto para no dominar la pantalla */
        max-height: 280px;
    }

    .bienvenida-imagen img {
        height: 280px;
    }

    .bienvenidaSlideContenido > .tituloPagina,
    .bienvenidaSlideContenido > .bienvenidaTitulo,
    .bienvenidaSlideContenido > .bienvenidaParrafo,
    .bienvenidaSlideContenido > .btn-base {
        text-align: center;
    }

    .bienvenidaSlideContenido > .btn-base {
        min-height: var(--altura-boton-movil);
    }

    .bienvenida-imagen img {
        margin: 0 auto;
    }
}

/*Fin de bienvenida*/

/*Novedad del catálogo*/

.novedadCatalogo{
    padding: 20px;
    background-color: var(--color-blanco);
    box-shadow: var(--sombra-media);
}


/*
 * CONTENEDOR DEL SLIDER: Layout de 3 columnas con CSS Grid
 * Columna 1 (48px): Botón "Anterior" centrado
 * Columna 2 (1fr):  Ventana visible del slider
 * Columna 3 (48px): Botón "Siguiente" centrado
 * NO usa librerías externas — todo es CSS Grid + translateX en JS
 */
.sliderContenedor {
    display: grid;
    grid-template-columns: 48px 1fr 48px;
    align-items: center;
    width: 100%;
    box-sizing: border-box;
    gap: calc(var(--unidad-espaciado) * 1);
}

/* Posicionamiento del botón en su celda del grid */
/* Los estilos visuales (color, forma, tamaño) están en btnSlider.css */
.sliderContenedor .btn-slider {
    padding: 0;
    justify-self: center;
    align-self: center;
}

/*
 * VENTANA DEL SLIDER: zona visible que recorta el contenido
 * overflow:hidden oculta los items que están fuera de vista
 * min-width:0 evita que el grid se desborde por el contenido flex
 */
.sliderVentana {
    overflow: hidden;
    width: 100%;
    min-width: 0;
    padding: 10px 0;
}

/*
 * PISTA DEL SLIDER: fila horizontal de items
 * Se desplaza con transform:translateX() desde JavaScript
 * transition da la animación suave al moverse
 */
.sliderPista {
    display: flex;
    gap: 20px;
    transition: transform 0.4s ease;
}

/* Cada item del slider: ancho fijo para que quepan N por fila */
.sliderItem {
    flex-shrink: 0;
    display: flex;
    justify-content: center;
    align-items: flex-start;
}

.novedadCatalogoCard{
    /*Este width tiene que coincididr con el tamño de la 
    imagen o si no se rompe el codigo
    de la clase .novedadImagen
    */
    width: 100%;
    max-width: 200px;
    min-width: 200px;
    height: 100%;
    min-height: 360px;
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
}
/* Hover solo en dispositivos con ratón (evita crash en iOS Safari por transforms + Swiper) */
@media (hover: hover) {
    .novedadCatalogoCard {
        transition: transform 0.3s ease;
    }
    .novedadCatalogoCard:hover {
        transform: scale(1.05);
        z-index: 100; 
    }
}

.novedadImagen{
    border: 1px solid var(--color-borde);
    border-radius: var(--radio-pequeno);
    box-shadow: var(--sombra-suave);
    width: 200px;
    height: 300px;
    overflow:hidden;
    display: flex;
    align-items: center;
    justify-content: center;
}
.novedadImagen img{
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
}
.novedadInfo{
    display: flex;
    flex-direction: column;
    align-items: center;
    flex-grow: 1; /*Esto hace que el div ocupe el resto del espacio disponible*/
    width: 100%;

}

.novedadInfo .btn-verde{
    margin-top: auto; /*Esto empuja el botón hacia abajo*/
}



/*Fin de novedad del catálogo*/

/*Agenda de Eventos*/
