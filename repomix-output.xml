<file path="public/css/panelAdmin/gestionarNoticias.css">
/* ==============================================
   PÁGINA: Gestionar Noticias
   Layout: Formulario (izquierda) + Listado cards (derecha)
   Sigue el patrón de gestionarContenidoEventos.css
   ============================================== */

/* --- Contenedor principal de la página --- */
.gestionarNoticias {
    display: flex;
    flex-direction: column;
    background: var(--blanco);
    padding: calc(var(--unidad-espaciado) * 3);
    gap: calc(var(--unidad-espaciado) * 2);
}

/* --- Encabezado superior de la sección --- */
.noticiasEncabezado h1 {
    color: var(--color-primario-oscuro);
    margin-bottom: calc(var(--unidad-espaciado) * 0.5);
}

.noticiasEncabezado p {
    color: var(--color-texto-mutado);
    font-size: 0.95rem;
}

/* ==============================================
   LAYOUT DE DOS COLUMNAS (formulario + listado)
   ============================================== */
.noticiasLayout {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: calc(var(--unidad-espaciado) * 3);
    align-items: start;
}

/* ==============================================
   COLUMNA IZQUIERDA: FORMULARIO
   ============================================== */
.noticiasFormulario {
    position: sticky;
    top: calc(var(--unidad-espaciado) * 2);
}

/* Estilo del formulario interior con barra lateral de acento */
.noticiasFormularioInner {
    background: var(--color-fondo-global);
    border-radius: 0 8px 8px 0;
    padding: calc(var(--unidad-espaciado) * 3);
    box-shadow: var(--sombra-suave);
    display: flex;
    flex-direction: column;
    gap: calc(var(--unidad-espaciado) * 2);
}

/* Título del formulario */
.noticiasFormularioInner h2 {
    color: var(--color-primario-oscuro);
    font-size: 1.2rem;
    padding-bottom: calc(var(--unidad-espaciado) * 1);
    border-bottom: 1px solid var(--color-borde);
}

/* Grupo de campo (label + input) en columna */
.noticiasGrupoFormulario {
    display: flex;
    flex-direction: column;
    gap: calc(var(--unidad-espaciado) * 0.5);
}

/* Grupo de campo tipo checkbox en fila */
.noticiasGrupoFormularioCheck {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: calc(var(--unidad-espaciado) * 1);
}

/* Etiqueta del campo */
.noticiasGrupoFormulario label,
.noticiasGrupoFormularioCheck label {
    color: var(--color-primario-oscuro);
    font-weight: 600;
    font-size: 0.88rem;
}

/* Inputs, textarea y select del formulario */
.noticiasGrupoFormulario input,
.noticiasGrupoFormulario textarea,
.noticiasGrupoFormulario select {
    padding: calc(var(--unidad-espaciado) * 1) calc(var(--unidad-espaciado) * 1.5);
    border: 1px solid var(--color-borde-input);
    border-radius: 6px;
    font-size: 0.92rem;
    font-family: var(--fuente-familia);
    background: var(--blanco);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
}

/* Estado de foco en los campos del formulario */
.noticiasGrupoFormulario input:focus,
.noticiasGrupoFormulario textarea:focus,
.noticiasGrupoFormulario select:focus {
    outline: none;
    border-color: var(--color-secundario);
    box-shadow: 0 0 0 3px rgba(80, 227, 194, 0.2);
}

/* Textarea con altura mínima para el contenido */
.noticiasGrupoFormulario textarea {
    resize: vertical;
    min-height: 100px;
    max-height: 200px;
    overflow-y: auto;
}

/* Checkbox con tamaño accesible */
.noticiasGrupoFormularioCheck input[type="checkbox"] {
    width: 18px;
    height: 18px;
    accent-color: var(--color-secundario);
    cursor: pointer;
}

/* Botón de enviar formulario (ancho completo) */
.noticiasBotonEnvio {
    width: 100%;
    padding: calc(var(--unidad-espaciado) * 1.5);
    /* Antes var(--color-primario): 3.3:1 con texto blanco */
    background: var(--admin-color-primario);
    color: var(--blanco);
    border: none;
    border-radius: 6px;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s ease, transform 0.15s ease, box-shadow 0.2s ease;
}

/* Hover del botón de envío */
.noticiasBotonEnvio:hover {
    background: var(--admin-color-primario-hover);
    box-shadow: var(--sombra-media);
    transform: translateY(-2px);
}

.noticiasBotonEnvio:focus-visible {
    outline: 3px solid var(--admin-color-foco);
    outline-offset: 2px;
}

/* ==============================================
   COLUMNA DERECHA: LISTADO DE NOTICIAS
   ============================================== */
.noticiasListado h2 {
    color: var(--color-primario-oscuro);
    font-size: 1.2rem;
    margin-bottom: calc(var(--unidad-espaciado) * 2);
    padding-bottom: calc(var(--unidad-espaciado) * 1);
    border-bottom: 1px solid var(--color-borde);
}

/* Contenedor con scroll para las tarjetas */
.noticiasListadoCards {
    display: flex;
    flex-direction: column;
    gap: calc(var(--unidad-espaciado) * 2);
    max-height: 78vh;
    overflow-y: auto;
    padding-right: calc(var(--unidad-espaciado) * 1);
    /*Esto es una prueba*/
    scrollbar-width: thin;
    scrollbar-color: var(--color-secundario) transparent;
}

/* ==============================================
   TARJETA INDIVIDUAL DE NOTICIA
   ============================================== */
.noticiaCard {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: calc(var(--unidad-espaciado) * 2);
    background: var(--blanco);
    border: 1px solid var(--color-borde);
    border-radius: 0 8px 8px 0;
    padding: calc(var(--unidad-espaciado) * 2);
    box-shadow: var(--sombra-suave);
    transition: box-shadow 0.2s ease, transform 0.15s ease;
}

/* Efecto hover en la tarjeta */
.noticiaCard:hover {
    box-shadow: var(--sombra-media);
    transform: translateY(-2px);
}

/* Bloque de info (ocupa todo el espacio disponible) */
.noticiaCardInfo {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: calc(var(--unidad-espaciado) * 0.75);
}

/* Cabecera de la tarjeta: categoría + destacado */
.noticiaCardCabecera {
    display: flex;
    align-items: center;
    gap: calc(var(--unidad-espaciado) * 1);
    flex-wrap: wrap;
}

/* Badge de categoría genérico */
.noticiaCardCategoria {
    font-size: 0.72rem;
    font-weight: 700;
    padding: 2px 10px;
    border-radius: 10px;
    color: var(--blanco);
    white-space: nowrap;
    background: var(--color-texto-mutado);
}

/* Variantes de categoría por color */
.noticiaCardCategoria--general {
    /* Antes var(--color-primario): 3.3:1 con texto blanco */
    background: var(--admin-color-primario);
}

.noticiaCardCategoria--eventos {
    background: var(--color-secundario);
    color: var(--color-texto-principal);
}

.noticiaCardCategoria--novedades {
    background: var(--bgBtnVerde);
}

.noticiaCardCategoria--avisos {
    /* Antes var(--colorComplementarioTerciario) (#FFA200): 2:1 con texto blanco */
    background: #B45309;
}

/* Badge de noticia destacada */
.noticiaCardDestacado {
    font-size: 0.72rem;
    font-weight: 600;
    /* Antes var(--colorComplementarioTerciario) (#FFA200) sobre blanco: 2:1 */
    color: #B45309;
}

/* Título de la noticia en la tarjeta */
.noticiaCardTitulo {
    color: var(--color-texto-principal);
    font-size: 1rem;
    font-weight: 600;
}

/* Contenido de la noticia (máximo 2 líneas) */
.noticiaCardContenido {
    color: var(--color-texto-mutado);
    font-size: 0.88rem;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

/* Fila de metadatos (autor, fecha) */
.noticiaCardMeta {
    display: flex;
    flex-wrap: wrap;
    gap: calc(var(--unidad-espaciado) * 1.5);
    margin-top: calc(var(--unidad-espaciado) * 0.5);
}

/* Cada ítem de metadatos */
.noticiaCardMetaItem {
    font-size: 0.8rem;
    color: var(--color-texto-mutado);
    background: var(--color-card-evento);
    padding: 2px 10px;
    border-radius: 10px;
    white-space: nowrap;
}

/* ==============================================
   ACCIONES DE LA TARJETA (Editar / Eliminar)
   ============================================== */
.noticiaCardAcciones {
    display: flex;
    flex-direction: column;
    gap: calc(var(--unidad-espaciado) * 1);
    flex-shrink: 0;
}

/* Botones de acción dentro de la tarjeta */
.btnEditarNoticia,
.btnEliminarNoticia {
    padding: 6px 12px;
    font-size: 0.78rem;
    border-radius: 4px;
    cursor: pointer;
    white-space: nowrap;
    text-align: center;
    text-decoration: none;
}

/* ==============================================
   ALERTAS DE FEEDBACK (Éxito / Error)
   ============================================== */
.gestionarNoticias .alertaExito {
    background: var(--color-exito);
    color: var(--blanco);
    padding: calc(var(--unidad-espaciado) * 1.5);
    border-radius: 6px;
    font-weight: 600;
    font-size: 0.92rem;
}

.gestionarNoticias .alertaError {
    background: var(--color-error);
    color: var(--blanco);
    padding: calc(var(--unidad-espaciado) * 1.5);
    border-radius: 6px;
    font-weight: 600;
    font-size: 0.92rem;
}

/* Errores de validación bajo cada campo */
.noticiasError {
    color: var(--color-error);
    font-size: 0.78rem;
    font-weight: 500;
}

/* Botón de cancelar edición (ancho completo) */
.noticiasBtnCancelar {
    display: block;
    width: 100%;
    text-align: center;
    padding: calc(var(--unidad-espaciado) * 1);
    text-decoration: none;
    border-radius: 6px;
    font-weight: 600;
}

/* Mensaje cuando no hay noticias */
.noticiaCardVacio {
    text-align: center;
    color: var(--color-texto-mutado);
    padding: calc(var(--unidad-espaciado) * 4) 0;
    font-size: 0.95rem;
}

/* ==============================================
   RESPONSIVE: Tablet (menos de 992px)
   ============================================== */
@media (max-width: 992px) {
    /* En tablet, se apilan las columnas */
    .noticiasLayout {
        grid-template-columns: 1fr;
    }

    /* El formulario deja de ser sticky */
    .noticiasFormulario {
        position: static;
    }

    /* El scroll del listado se reduce */
    .noticiasListadoCards {
        max-height: 60vh;
    }
}

/* ==============================================
   RESPONSIVE: Móvil (menos de 600px)
   ============================================== */
@media (max-width: 600px) {
    /* Reducimos el padding general */
    .gestionarNoticias {
        padding: var(--relleno-no-movil);
    }

    /* Las tarjetas se apilan en columna */
    .noticiaCard {
        flex-direction: column;
        align-items: flex-start;
    }

    /* Las acciones pasan a fila horizontal */
    .noticiaCardAcciones {
        flex-direction: row;
        width: 100%;
    }

    /* Botones ocupan ancho completo en móvil */
    .btnEditarNoticia,
    .btnEliminarNoticia {
        flex: 1;
        text-align: center;
        min-height: var(--altura-boton-movil);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /* Los metadatos en columna en móvil */
    .noticiaCardMeta {
        flex-direction: column;
        gap: calc(var(--unidad-espaciado) * 0.5);
    }
}
</file>

<file path="public/css/panelAdmin/gestionarUsuarios.css">
/* ==============================================
   PÁGINA: Gestionar Usuarios y Administradores
   Layout: Buscador + Formulario edición + Listado cards
   Sigue el patrón de gestionarNoticias.css
   ============================================== */

/* --- Contenedor principal de la página --- */
.gestionUsuarios {
    display: flex;
    flex-direction: column;
    background: var(--blanco);
    padding: calc(var(--unidad-espaciado) * 3);
    gap: calc(var(--unidad-espaciado) * 3);
}

/* --- Encabezado superior de la sección --- */
.gestionUsuariosEncabezado h1 {
    color: var(--color-primario-oscuro);
    margin-bottom: calc(var(--unidad-espaciado) * 0.5);
}

.gestionUsuariosEncabezado p {
    color: var(--color-texto-mutado);
    font-size: 0.95rem;
}

/* --- Alertas de feedback --- */
.gestionUsuarios .alertaExito {
    background: var(--color-exito);
    color: var(--blanco);
    padding: calc(var(--unidad-espaciado) * 1.5);
    border-radius: 6px;
    font-weight: 600;
    font-size: 0.92rem;
}

.gestionUsuarios .alertaError {
    background: var(--color-error);
    color: var(--blanco);
    padding: calc(var(--unidad-espaciado) * 1.5);
    border-radius: 6px;
    font-weight: 600;
    font-size: 0.92rem;
}

/* ==============================================
   BUSCADOR DE USUARIOS
   ============================================== */
.gestionUsuariosBuscador {
    background: var(--color-fondo-global);
    border-radius: 0 8px 8px 0;
    padding: calc(var(--unidad-espaciado) * 2.5);
    box-shadow: var(--sombra-suave);
}

.gestionUsuariosBuscador h2 {
    color: var(--color-primario-oscuro);
    font-size: 1.1rem;
    margin-bottom: calc(var(--unidad-espaciado) * 2);
    padding-bottom: calc(var(--unidad-espaciado) * 1);
    border-bottom: 1px solid var(--color-borde);
}

/* Fila de filtros en grid responsive */
.gestionUsuariosFiltros {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: calc(var(--unidad-espaciado) * 2);
    margin-bottom: calc(var(--unidad-espaciado) * 2);
}

/* Grupo de filtro (label + input) */
.gestionUsuariosGrupoFiltro {
    display: flex;
    flex-direction: column;
    gap: calc(var(--unidad-espaciado) * 0.5);
}

.gestionUsuariosGrupoFiltro label {
    color: var(--color-primario-oscuro);
    font-weight: 600;
    font-size: 0.85rem;
}

.gestionUsuariosGrupoFiltro input {
    padding: calc(var(--unidad-espaciado) * 1) calc(var(--unidad-espaciado) * 1.5);
    border: 1px solid var(--color-borde-input);
    border-radius: 6px;
    font-size: 0.92rem;
    font-family: var(--fuente-familia);
    background: var(--blanco);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
}

.gestionUsuariosGrupoFiltro input:focus {
    outline: none;
    border-color: var(--color-primario);
    box-shadow: 0 0 0 3px rgba(74, 144, 226, 0.15);
}

/* Botones de buscar y limpiar */
.gestionUsuariosBotonesFiltr {
    display: flex;
    gap: calc(var(--unidad-espaciado) * 1.5);
    width: 200px;
}

.gestionUsuariosBotonesFiltr .btn-base {
    text-decoration: none;
}

.gestionUsuariosLayout {
    display: grid;
    grid-template-columns: 1fr;
    gap: calc(var(--unidad-espaciado) * 3);
    align-items: start;
}

/* Si existe el formulario de edición, activamos 2 columnas */
.gestionUsuariosLayout:has(.gestionUsuariosFormulario) {
    grid-template-columns: 1fr 1.5fr;
}

/* ==============================================
   FORMULARIO DE EDICIÓN DE USUARIO
   ============================================== */
.gestionUsuariosFormulario {
    position: sticky;
    top: calc(var(--unidad-espaciado) * 2);
}

.gestionUsuariosFormInner {
    background: var(--color-fondo-global);
    border-left: 4px solid var(--color-primario);
    border-radius: 0 8px 8px 0;
    padding: calc(var(--unidad-espaciado) * 3);
    box-shadow: var(--sombra-suave);
    display: flex;
    flex-direction: column;
    gap: calc(var(--unidad-espaciado) * 2);
}

.gestionUsuariosFormInner h2 {
    color: var(--color-primario-oscuro);
    font-size: 1.2rem;
    padding-bottom: calc(var(--unidad-espaciado) * 1);
    border-bottom: 1px solid var(--color-borde);
}

/* Grupo de campo (label + input) en columna */
.gestionUsuariosGrupoForm {
    display: flex;
    flex-direction: column;
    gap: calc(var(--unidad-espaciado) * 0.5);
}

.gestionUsuariosGrupoForm label {
    color: var(--color-primario-oscuro);
    font-weight: 600;
    font-size: 0.88rem;
}

.gestionUsuariosGrupoForm input {
    padding: calc(var(--unidad-espaciado) * 1) calc(var(--unidad-espaciado) * 1.5);
    border: 1px solid var(--color-borde-input);
    border-radius: 6px;
    font-size: 0.92rem;
    font-family: var(--fuente-familia);
    background: var(--blanco);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
}

.gestionUsuariosGrupoForm input:focus {
    outline: none;
    border-color: var(--color-primario);
    box-shadow: 0 0 0 3px rgba(74, 144, 226, 0.15);
}

.gestionUsuariosGrupoForm input:disabled {
    background: var(--grisClaro);
    cursor: not-allowed;
    opacity: 0.7;
}

/* Errores de validación */
.gestionUsuariosError {
    color: var(--color-error);
    font-size: 0.78rem;
    font-weight: 500;
}

/* Botón de enviar formulario */
.gestionUsuariosBotonEnvio {
    width: 100%;
    padding: calc(var(--unidad-espaciado) * 1.5);
    /* Antes var(--color-primario): 3.3:1 con texto blanco */
    background: var(--admin-color-primario);
    color: var(--blanco);
    border: none;
    border-radius: 6px;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s ease, transform 0.15s ease, box-shadow 0.2s ease;
}

.gestionUsuariosBotonEnvio:focus-visible {
    outline: 3px solid var(--admin-color-foco);
    outline-offset: 2px;
}

.gestionUsuariosBotonEnvio:hover {
    background: var(--admin-color-primario-hover);
    box-shadow: var(--sombra-media);
    transform: translateY(-2px);
}

/* Botón de cancelar edición */
.gestionUsuariosBtnCancelar {
    display: block;
    width: 100%;
    text-align: center;
    padding: calc(var(--unidad-espaciado) * 1);
    text-decoration: none;
    border-radius: 6px;
    font-weight: 600;
}

/* ==============================================
   LISTADO DE USUARIOS
   ============================================== */
.gestionUsuariosListado h2 {
    color: var(--color-primario-oscuro);
    font-size: 1.2rem;
    margin-bottom: calc(var(--unidad-espaciado) * 2);
    padding-bottom: calc(var(--unidad-espaciado) * 1);
    border-bottom: 1px solid var(--color-borde);
}

/* Contenedor con scroll para las tarjetas de usuarios */
.gestionUsuariosCards {
    display: flex;
    flex-direction: column;
    gap: calc(var(--unidad-espaciado) * 2);
    max-height: 70vh;
    overflow-y: auto;
    padding-right: calc(var(--unidad-espaciado) * 1);
    scrollbar-width: thin;
    scrollbar-color: var(--color-primario) transparent;
}

/* ==============================================
   TARJETA INDIVIDUAL DE USUARIO
   ============================================== */
.usuarioCard {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: calc(var(--unidad-espaciado) * 2);
    background: var(--blanco);
    border: 1px solid var(--color-borde);
    border-radius: 0 8px 8px 0;
    padding: calc(var(--unidad-espaciado) * 2);
    box-shadow: var(--sombra-suave);
    transition: box-shadow 0.2s ease, transform 0.15s ease;
}

.usuarioCard:hover {
    box-shadow: var(--sombra-media);
    transform: translateY(-2px);
}

/* Bloque de info (ocupa todo el espacio disponible) */
.usuarioCardInfo {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: calc(var(--unidad-espaciado) * 0.75);
}

/* Cabecera de la tarjeta: ID + nombre + nº socio */
.usuarioCardCabecera {
    display: flex;
    align-items: center;
    gap: calc(var(--unidad-espaciado) * 1);
    flex-wrap: wrap;
}

/* Badge del ID del usuario */
.usuarioCardId {
    /* Antes var(--color-primario): 3.3:1 con texto blanco */
    background: var(--admin-color-primario);
    color: var(--blanco);
    font-size: 0.72rem;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 10px;
    white-space: nowrap;
}

/* Nombre del usuario */
.usuarioCardNombre {
    color: var(--color-texto-principal);
    font-size: 1rem;
    font-weight: 600;
}

/* Badge del nº de socio */
.usuarioCardSocio {
    background: var(--color-secundario);
    color: var(--color-texto-principal);
    font-size: 0.72rem;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 10px;
    white-space: nowrap;
}

/* Fila de metadatos (email, DNI, móvil, fecha) */
.usuarioCardMeta {
    display: flex;
    flex-wrap: wrap;
    gap: calc(var(--unidad-espaciado) * 1.5);
    margin-top: calc(var(--unidad-espaciado) * 0.5);
}

.usuarioCardMetaItem {
    font-size: 0.8rem;
    color: var(--color-texto-mutado);
    background: var(--color-card-evento);
    padding: 2px 10px;
    border-radius: 10px;
    white-space: nowrap;
}

/* Acciones de la tarjeta */
.usuarioCardAcciones {
    display: flex;
    flex-direction: column;
    gap: calc(var(--unidad-espaciado) * 1);
    flex-shrink: 0;
}

.btnEditarUsuario,
.btnEliminarUsuario {
    padding: 6px 12px;
    font-size: 0.78rem;
    border-radius: 4px;
    cursor: pointer;
    white-space: nowrap;
    text-align: center;
    text-decoration: none;
}

/* Mensaje cuando no hay usuarios */
.usuarioCardVacio {
    text-align: center;
    color: var(--color-texto-mutado);
    padding: calc(var(--unidad-espaciado) * 4) 0;
    font-size: 0.95rem;
}

/* ==============================================
   SECCIÓN: LISTADO DE ADMINISTRADORES
   ============================================== */
.gestionAdminsSeccion {
    border-top: 2px solid var(--color-borde);
    padding-top: calc(var(--unidad-espaciado) * 3);
}

.gestionAdminsSeccion h2 {
    color: var(--color-primario-oscuro);
    font-size: 1.2rem;
    margin-bottom: calc(var(--unidad-espaciado) * 2);
    padding-bottom: calc(var(--unidad-espaciado) * 1);
    border-bottom: 1px solid var(--color-borde);
}

/* Grid de tarjetas de administradores */
.gestionAdminsCards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
    gap: calc(var(--unidad-espaciado) * 2);
}

/* Tarjeta individual de administrador */
.adminCard {
    background: var(--blanco);
    border: 1px solid var(--color-borde);
    border-radius: 0 8px 8px 0;
    padding: calc(var(--unidad-espaciado) * 2);
    box-shadow: var(--sombra-suave);
    transition: box-shadow 0.2s ease, transform 0.15s ease;
}

.adminCard:hover {
    box-shadow: var(--sombra-media);
    transform: translateY(-2px);
}

.adminCardInfo {
    display: flex;
    flex-direction: column;
    gap: calc(var(--unidad-espaciado) * 0.75);
}

/* Cabecera: ID + nombre + rol */
.adminCardCabecera {
    display: flex;
    align-items: center;
    gap: calc(var(--unidad-espaciado) * 1);
    flex-wrap: wrap;
}

.adminCardId {
    /* Antes var(--colorComplementarioTerciario) (#FFA200): 2:1 con texto blanco */
    background: #B45309;
    color: var(--blanco);
    font-size: 0.72rem;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 10px;
    white-space: nowrap;
}

.adminCardNombre {
    color: var(--color-texto-principal);
    font-size: 1rem;
    font-weight: 600;
}

/* Badges de roles */
.adminCardRol {
    font-size: 0.72rem;
    font-weight: 700;
    padding: 2px 10px;
    border-radius: 10px;
    color: var(--blanco);
    white-space: nowrap;
}

.adminCardRol--superadmin {
    background: var(--bgBtnRojo);
}

.adminCardRol--editor {
    /* Antes var(--color-primario): 3.3:1 con texto blanco */
    background: var(--admin-color-primario);
}

.adminCardRol--moderador {
    background: var(--bgBtnVerde);
}

/* Metadatos del admin */
.adminCardMeta {
    display: flex;
    flex-wrap: wrap;
    gap: calc(var(--unidad-espaciado) * 1.5);
    margin-top: calc(var(--unidad-espaciado) * 0.5);
}

.adminCardMetaItem {
    font-size: 0.8rem;
    color: var(--color-texto-mutado);
    background: var(--color-card-evento);
    padding: 2px 10px;
    border-radius: 10px;
    white-space: nowrap;
}

/* Badge de cuenta demo */
.adminCardMetaItemDemo {
    font-size: 0.8rem;
    color: var(--blanco);
    background: var(--bgBtnRojo);
    padding: 2px 10px;
    border-radius: 10px;
    white-space: nowrap;
    font-weight: 600;
}

.adminCardVacio {
    text-align: center;
    color: var(--color-texto-mutado);
    padding: calc(var(--unidad-espaciado) * 3) 0;
    font-size: 0.95rem;
}

/* ==============================================
   RESPONSIVE: Tablet (menos de 992px)
   ============================================== */
@media (max-width: 992px) {
    /* En tablet, formulario y listado se apilan */
    .gestionUsuariosLayout,
    .gestionUsuariosLayout:has(.gestionUsuariosFormulario) {
        grid-template-columns: 1fr;
    }

    .gestionUsuariosFormulario {
        position: static;
    }

    .gestionUsuariosCards {
        max-height: 60vh;
    }

    /* Admins en una sola columna */
    .gestionAdminsCards {
        grid-template-columns: 1fr;
    }
}

/* ==============================================
   RESPONSIVE: Móvil (menos de 600px)
   ============================================== */
@media (max-width: 600px) {
    .gestionUsuarios {
        padding: var(--relleno-no-movil);
    }

    /* Filtros en una columna */
    .gestionUsuariosFiltros {
        grid-template-columns: 1fr;
    }

    /* Tarjetas de usuario se apilan */
    .usuarioCard {
        flex-direction: column;
        align-items: flex-start;
    }

    .usuarioCardAcciones {
        flex-direction: row;
        width: 100%;
    }

    .btnEditarUsuario,
    .btnEliminarUsuario {
        flex: 1;
        text-align: center;
        min-height: var(--altura-boton-movil);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .usuarioCardMeta {
        flex-direction: column;
        gap: calc(var(--unidad-espaciado) * 0.5);
    }

    .adminCardMeta {
        flex-direction: column;
        gap: calc(var(--unidad-espaciado) * 0.5);
    }
}
</file>

<file path="public/css/panelAdmin/navAdmin.css">
/* ==========================================================================
   NAV DEL ADMIN — barra minimalista clara (antes bloque azul sólido)
   ========================================================================== */
.navAdmin {
    display: none;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    background-color: var(--admin-color-fondo-tarjeta);
    border: 1px solid var(--admin-color-borde);
    gap: 8px;
    overflow: visible;
    padding: 10px;
    box-shadow: var(--sombra-suave);
    border-radius: 8px;
}

.navAdmin.navAdminVisible {
    display: flex;
}

.navContenidoLibro, .irADashboard, .navContenidoUsuario, .navContenidoWeb, .navContenidoSesion {
    display: flex;
    flex-direction: column;
    justify-content: center;
    position: relative;
    width: fit-content;
}

/* Enlace "Dashboard": único punto de acento de color en la barra, para marcarlo como inicio */
.irADashboard {
    background-color: var(--admin-color-primario);
    color: var(--color-blanco);
    padding: 8px 16px;
    border-radius: 6px;
    font-weight: 600;
    text-decoration: none;
}

.irADashboard:hover {
    background-color: var(--admin-color-primario-hover);
}

.btnDesplegableAdmin{
    text-align: left;
    border: none;
}

/* Botones desplegables: estilo "texto" (ghost), no bloques de color sólido */
.btnDesplegableAdmin button {
    cursor: pointer;
    padding: 8px 16px;
    background-color: transparent;
    color: var(--admin-color-texto);
    font-weight: 500;
    border-radius: 6px;
    width: 100%;
    text-align: left;
    transition: background-color 0.15s ease, color 0.15s ease;
}

.btnDesplegableAdmin button:hover {
    background-color: var(--admin-color-fondo);
    color: var(--admin-color-primario);
}

/* Foco visible para navegación por teclado (accesibilidad) */
.btnDesplegableAdmin button:focus-visible,
.menu-button:focus-visible,
.logout-button:focus-visible,
.irADashboard:focus-visible,
.menu-items li a:focus-visible {
    outline: 3px solid var(--admin-color-foco);
    outline-offset: 2px;
}

/* Panel desplegable: tarjeta blanca con sombra, en vez de bloque azul */
.menu-items {
    display: none;
    list-style: none;
    padding: 8px;
    position: absolute;
    z-index: 110;
    top: 100%;
    left: 0;
    width: max-content;
    min-width: 250px;
    background-color: var(--admin-color-fondo-tarjeta);
    border: 1px solid var(--admin-color-borde);
    border-radius: 8px;
    box-shadow: var(--sombra-media);
}

.menu-items.is-active {
    display: block;
}
.btnNavAdminPrincipal {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 10px 0;
    position: relative;
    z-index: 100;
}


/* Botón de menú hamburguesa (móvil): estilo ghost consistente con el resto de la barra */
#btnMenuPrincipal {
    background-color: var(--admin-color-fondo-tarjeta);
    color: var(--admin-color-texto);
    border: 1px solid var(--admin-color-borde);
}

.menu-button {
    cursor: pointer;
    padding: 8px 16px;
    background-color: transparent;
    color: var(--admin-color-texto);
    border-radius: 6px;
    display: inline-block;
}

.menu-button:hover {
    background-color: var(--admin-color-fondo);
    color: var(--admin-color-primario);
}

/* Botón de cerrar sesión: acento en rojo (acción destructiva/salida), estilo outline */
.logout-button {
    cursor: pointer;
    padding: 8px 16px;
    background-color: transparent;
    color: var(--bgBtnRojo);
    border: 1px solid var(--bgBtnRojo);
    border-radius: 6px;
    font-weight: 600;
    transition: background-color 0.15s ease, color 0.15s ease;
}

.logout-button:hover {
    background-color: var(--bgBtnRojo);
    color: var(--color-blanco);
}

.menu-items li {
    margin: 2px 0;
}

.menu-items li a {
    display: block;
    padding: 6px 10px;
    border-radius: 6px;
    color: var(--admin-color-texto);
    text-decoration: none;
    font-size: 0.9rem;
}

.menu-items li a:hover {
    background-color: var(--admin-color-fondo);
    color: var(--admin-color-primario);
}

.sub-menu-items {
    list-style: none;
    margin-top: 4px;
    padding-left: 12px;
}

@media (min-width: 768px) {
    .navAdmin {
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: flex-start;
        gap: 6px;
        padding: 10px 16px;
        width: 100%;
        position: static;
        top: auto;
        left: auto;
        z-index: 20;
        box-shadow: none;
        border-radius: 0;
        border: none;
        border-bottom: 1px solid var(--admin-color-borde);
    }

    /* El botón de cerrar sesión se separa a la derecha del todo */
    .navContenidoSesion {
        margin-left: auto;
    }

    .menu-items {
        box-shadow: var(--sombra-media);
        position: absolute; 
        top: 100%;
        left: 0;
        width: auto;
    }

    #btnMenuPrincipal {
        display: none;
    }

}
</file>

<file path="public/css/panelAdmin/publicacionesUser.css">
/* ==================================================
   PANEL ADMIN - GESTIONAR PUBLICACIONES DE USUARIOS
   ================================================== */

.gestionPublicacionesPage {
    display: flex;
    flex-direction: column;
    gap: calc(var(--unidad-espaciado) * 3);
    background: var(--blanco);
    padding: calc(var(--unidad-espaciado) * 3);
}

.publicacionesEncabezado h1 {
    color: var(--color-primario-oscuro);
    margin-bottom: calc(var(--unidad-espaciado) * 0.5);
}

.publicacionesEncabezado p {
    color: var(--color-texto-mutado);
}

.publicacionesResumen {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: calc(var(--unidad-espaciado) * 1.5);
}

.publicacionResumenCard {
    background: var(--color-fondo-global);
    border: 1px solid var(--color-borde);
    border-radius: var(--radio-borde);
    padding: calc(var(--unidad-espaciado) * 1.5);
    box-shadow: var(--sombra-suave);
}

.publicacionResumenCard h3 {
