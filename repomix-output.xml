<file path="public/css/paneles/usuarioAutenticado/perfilUsuario.css">
/* =============================================
   ESTILOS DEL PERFIL DE USUARIO
   Contiene los estilos para la cabecera, métodos
   de pago e historial de actividad.
   ============================================= */

.perfilUsuario {
    background-color: var(--bgPerfilUsuario);
}

/* ======== CABECERA DEL PERFIL ======== */
.contenidoHeader {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-evenly;
    border-bottom: 1px solid var(--colorBorde);
}

.info-personalFoto img {
    border: 2px solid black;
    width: 150px;
    height: 150px;
    border-radius: 50%;
    object-fit: cover;
}

.texto-bienvenidaUsuario {
    justify-items: center;
    padding: 10px;
}

.texto-bienvenidaUsuario h1 {
    font-size: 1.7rem;
    margin-bottom: 10px;
    text-decoration: underline;
    color: var(--color-primario-oscuro);
}

.texto-bienvenidaUsuario p {
    font-size: 1rem;
    color: var(--color-primario);
}

.info-personalUsuario {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 5px;
    gap: 5px;
}

.info-personalUsuario h2 {
    font-size: 1.5rem;
    margin-bottom: 10px;
    text-decoration: underline;
    color: var(--color-primario-oscuro);
}

.info-personalUsuario p {
    font-size: 1rem;
}

/* ======== CONFIGURACIÓN DESPLEGABLE ======== */
.configCuentaUsuario {
    display: none;
    flex-direction: column;
    padding: 5px;
    gap: 5px;
}

.configCuentaUsuario h2 {
    font-size: 1.5rem;
    margin-bottom: 10px;
    text-decoration: underline;
    color: var(--color-primario-oscuro);
}

.configCuentaUsuario ul {
    list-style: none;
    padding: 0;
}

.configCuentaUsuario.configVisible {
    display: flex;
}

/* ======== HISTORIAL DE ACTIVIDAD ======== */
.contenidoHistorial {
    display: flex;
    flex-direction: column;
    padding: 10px;
    border-bottom: 1px solid var(--colorBorde);
}

.historialPrestamos h3,
.historialReservas h3,
.historialCompras h3,
.historialPublicaciones h3 {
    font-size: 1.5rem;
    margin-bottom: 20px;
    text-decoration: underline;
    color: var(--color-primario-oscuro);
}

.historialPrestamos,
.historialReservas,
.historialCompras,
.historialPublicaciones {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 24px;
}

/* Mensaje cuando no hay registros */
.sinRegistros {
    font-style: italic;
    color: var(--color-texto-mutado);
    padding: 8px 0;
}

/* ======== CONTENEDOR TIPO TABLA RESPONSIVA (divs) ======== */
.historialVersionDesktop {
    display: block;
}

/* Contenedor del grid que simula una tabla */
.tablaResponsive {
    width: 100%;
    border: 1px solid var(--colorBorde);
    border-radius: 4px;
    overflow: hidden;
}

/* Fila de cabecera (simula <thead>) */
.filaHeader {
    display: none;
    /* En móvil se oculta la cabecera */
}

/* Cada fila de datos (simula <tr>) */
.filaBody {
    display: flex;
    flex-direction: column;
    padding: 12px;
    border-bottom: 1px solid var(--colorBorde);
}

.filaBody:last-child {
    border-bottom: none;
}

/* Cada celda de datos (simula <td>) */
.celdaBody {
    display: flex;
    padding: 4px 0;
    font-size: 0.9rem;
    word-break: break-word;
}

/* En móvil mostramos el data-label como etiqueta */
.celdaBody::before {
    content: attr(data-label) ": ";
    font-weight: bold;
    min-width: 140px;
    flex-shrink: 0;
}

/* Botones de acciones dentro de la "tabla" */
.tablaAccionesBotones {
    display: flex;
    gap: 5px;
}

.celdaAcciones .tablaAccionesBotones {
    width: 100%;
    padding-top: 4px;
}

/* Ocultar el label del campo acciones en móvil */
.celdaAcciones::before {
    display: none;
}

/* ======== MEDIA QUERY TABLETS (768px+) ======== */
@media (min-width: 768px) {

    .contenidoHeader {
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        padding: 10px;
        border-bottom: 1px solid var(--colorBorde);
    }

    .info-personalFoto {
        padding-top: 10px;
        padding-bottom: 10px;
    }

    .texto-bienvenidaUsuario {
        border: 1px solid var(--colorBorde);
        justify-items: center;
    }

    .info-personalUsuario {
        flex-direction: column;
    }

    .configCuentaUsuario {
        display: flex;
    }

    #btnConfigUsuario {
        display: none;
    }
}

/* ======== MEDIA QUERY DESKTOP (1200px+) ======== */
@media (min-width: 1200px) {

    #contenidosHistorial {
        display: none;
    }

    /* La cabecera se muestra como fila de grid */
    .filaHeader {
        display: grid;
        background-color: var(--color-primario);
        color: var(--color-blanco);
        font-weight: bold;
        font-size: 0.85rem;
    }

    /* Las filas de datos también se muestran como grid */
    .filaBody {
        display: grid;
        flex-direction: unset;
        padding: 8px 0;
        align-items: center;
        border-bottom: 1px solid var(--colorBorde);
    }

    .filaBody:nth-child(even) {
        background-color: var(--color-fondo-global);
    }

    /* Celdas en modo desktop: sin label pseudo-element */
    .celdaBody::before {
        display: none;
    }

    .celdaHeader,
    .celdaBody {
        padding: 8px 10px;
        font-size: 0.85rem;
    }

    /* ---- Grid para préstamos (6 columnas) ---- */
    .historialPrestamos .filaHeader,
    .historialPrestamos .filaBody {
        grid-template-columns: 2fr 1.2fr 1fr 1fr 0.8fr 0.8fr;
    }

    /* ---- Grid para reservas eventos (6 columnas) ---- */
    .historialReservas .filaHeader,
    .historialReservas .filaBody {
        grid-template-columns: 2fr 1.5fr 1fr 0.6fr 0.8fr 0.8fr;
    }

    /* ---- Grid para compras (6 columnas) ---- */
    .historialCompras .filaHeader,
    .historialCompras .filaBody {
        grid-template-columns: 2fr 1.2fr 1fr 0.7fr 0.8fr 0.8fr;
    }

    /* ---- Grid para publicaciones (6 columnas) ---- */
    .historialPublicaciones .filaHeader,
    .historialPublicaciones .filaBody {
        grid-template-columns: 1.5fr 2fr 1.5fr 0.6fr 1fr 0.8fr;
    }
}
</file>

