<file path="public/css/panelAdmin/gestionarCarruselHome.css">
/* Estilos para Gestión del Carrusel Home - Panel Administrativo */

.gestionCarruselHome {
    padding: 20px;
    background: var(--blanco);
    margin-bottom: 20px;
}

.gestionCarruselHome h2 {
    color: var(--color-primario);
    font-size: 24px;
    text-decoration: underline;
    margin-bottom: calc(var(--unidad-espaciado) * 0.5);
}

.gestionCarruselHome p {
    color: var(--color-texto-principal);
    font-size: 16px;
    margin-bottom: calc(var(--unidad-espaciado) * 2);
}

/* === LAYOUT 2 COLUMNAS === */
.eventosLayout {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: 24px;
    margin-top: 16px;
}

/* Columna del formulario */
.eventosFormulario {
    align-self: start;
}

.eventosFormulario h3 {
    color: var(--color-primario);
    margin-bottom: 12px;
}

/* Formulario de Eventos */
.gestionFormularioCarrusel {
    display: flex;
    flex-direction: column;
    gap: calc(var(--unidad-espaciado) * 2);
    background-color: var(--color-fondo-global);
    padding: calc(var(--unidad-espaciado) * 3);
    border-radius: var(--radio-medio);
    box-shadow: var(--sombra-media);
}

/* Grupo de Formulario */
.gestionGrupoFormulario {
    display: flex;
    flex-direction: column;
    gap: calc(var(--unidad-espaciado) * 1);
}

/* Etiquetas del Formulario */
.gestionGrupoFormulario label {
    color: var(--color-primario-claro);
    font-weight: 600;
    font-size: 14px;
}

/* Inputs Generales */
.gestionGrupoFormulario input[type="text"],
.gestionGrupoFormulario input[type="datetime-local"],
.gestionGrupoFormulario input[type="file"],
.gestionGrupoFormulario input[type="number"],
.gestionGrupoFormulario input[type="url"],
.gestionGrupoFormulario textarea,
.gestionGrupoFormulario select {
    width: 100%;
    padding: var(--input-relleno);
    border: 1px solid var(--input-borde);
    border-radius: var(--radio-pequeno);

    color: var(--color-texto-principal);
    background-color: var(--color-blanco);
    transition: all var(--transicion-rapida);

}

/* Focus de Inputs */
.gestionGrupoFormulario input[type="text"]:focus,
.gestionGrupoFormulario input[type="datetime-local"]:focus,
.gestionGrupoFormulario input[type="file"]:focus,
.gestionGrupoFormulario input[type="number"]:focus,
.gestionGrupoFormulario input[type="url"]:focus,
.gestionGrupoFormulario textarea:focus,
.gestionGrupoFormulario select:focus {
    outline: none;
    border-color: var(--color-primario);
    box-shadow: var(--input-foco-sombra);
}

/* Textarea */
.gestionGrupoFormulario textarea {
    resize: vertical;
    min-height: 100px;
}

/* Select */
.gestionGrupoFormulario select {
    cursor: pointer;
}

/* Texto de ayuda bajo los campos del formulario */
.gestionAyudaCampo {
    display: block;
    margin-top: 4px;
    font-size: 0.82rem;
    color: var(--colorTexto);
    line-height: 1.4;
}

/* Botón Envío Formulario */
.gestionBotonEnvio {
    /* Antes var(--color-primario): 3.3:1 con texto blanco */
    background-color: var(--admin-color-primario);
    color: var(--color-blanco);
    border: none;
    padding: calc(var(--unidad-espaciado) * 1.5) calc(var(--unidad-espaciado) * 2);
    border-radius: var(--radio-pequeno);
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: all var(--transicion-rapida);
    width: 100%;
}

.gestionBotonEnvio:hover {
    background-color: var(--admin-color-primario-hover);
    box-shadow: var(--sombra-media);
    transform: translateY(-2px);
}

.gestionBotonEnvio:focus-visible {
    outline: 3px solid var(--admin-color-foco);
    outline-offset: 2px;
}

.gestionBotonEnvio:active {
    transform: translateY(0);
}

/* === COLUMNA DERECHA: LISTADO DE EVENTOS === */
.eventosListado h3 {
    color: var(--color-primario);
    margin-bottom: 12px;
}

/* Contenedor con scroll vertical */
.eventosListadoCards {
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-height: 78vh;
    overflow-y: auto;
    padding-right: 4px;
    scrollbar-width: thin;
}

/* Tarjeta individual de evento */
.eventoCard {
    display: grid;
    grid-template-columns: 110px 1fr auto;
    gap: 12px;
    align-items: center;
    padding: 12px;
    background-color: var(--color-blanco);
    border-radius: var(--radio-borde);
    box-shadow: var(--sombra-suave);
    border-left: 4px solid var(--color-primario);
    transition: box-shadow 0.2s;
}

.eventoCard:hover {
    box-shadow: var(--sombra-media);
}

/* Imagen dentro de la tarjeta */
.eventoCardImagen img {
    width: 110px;
    height: 75px;
    object-fit: cover;
    border-radius: var(--radio-borde);
}

.eventoCardSinImagen {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 110px;
    height: 75px;
    background-color: #e2e8f0;
    border-radius: var(--radio-borde);
    font-size: 0.75rem;
    /* Antes #94a3b8 sobre #e2e8f0 (2.1:1): muy por debajo del mínimo AA */
    color: var(--admin-color-texto-mutado);
}

/* Información del evento */
