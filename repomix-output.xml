       ========================================= */
   --fuente-familia: 'Inter', system-ui, -apple-system, sans-serif;
   --fuente-tamano-base: 16px;
   --fuente-altura-linea: 1.6;

   /* =========================================
      3. ESPACIADO Y TAMAÑOS BASE
      ========================================= */
   --unidad-espaciado: 8px;
   --relleno-no-movil: 16px;
   --altura-boton-movil: 44px;

   /* =========================================
      4. FORMULARIOS (INPUTS)
      ========================================= */
   --color-borde-input: #444;
   --input-borde: var(--color-borde-input);
   --input-relleno: 10px 12px;

   /* =========================================
      5. PANEL DE ADMINISTRACIÓN (paleta accesible, WCAG AA)
      -----------------------------------------
      Variables dedicadas SOLO al panel /admin. No reutilizamos --color-primario ni
      --color-secundario (usadas en el resto del sitio) porque con texto blanco encima
      no llegan al contraste mínimo 4.5:1 exigido por WCAG AA. Centralizamos aquí todos
      los colores del admin para no repetir hexadecimales sueltos en cada fichero.
      ========================================= */
   /* Azul principal: mismo tono de familia que --color-primario pero oscurecido
      para pasar de 3.3:1 a 6.7:1 de contraste con texto/iconos blancos. */
   --admin-color-primario: #1D4ED8;
   --admin-color-primario-hover: #1E40AF;
   /* Verde azulado (sustituye al turquesa --color-secundario, que solo daba 1.6:1). */
   --admin-color-secundario: #0F766E;
   --admin-color-secundario-hover: #115E59;

   /* Texto y fondos neutros del panel, pensados para dar un aspecto sobrio y profesional */
   --admin-color-texto: #1E293B;
   --admin-color-texto-mutado: #475569;
   --admin-color-fondo: #F1F5F9;
   --admin-color-fondo-tarjeta: #FFFFFF;
   --admin-color-borde: #CBD5E1;

   /* Color de foco: visible con teclado (accesibilidad), se usa en :focus-visible */
   --admin-color-foco: #1D4ED8;

   /* Estados (badges de éxito/error/advertencia) en formato "fondo claro + texto oscuro
      del mismo tono": este patrón da contrastes de 5:1 a 7:1 sin perder el código de color. */
   --admin-badge-exito-bg: #DCFCE7;
   --admin-badge-exito-texto: #166534;
   --admin-badge-error-bg: #FEE2E2;
   --admin-badge-error-texto: #991B1B;
   --admin-badge-advertencia-bg: #FEF3C7;
   --admin-badge-advertencia-texto: #92400E;
   --admin-badge-neutro-bg: #E2E8F0;
   --admin-badge-neutro-texto: #334155;
}


/* =========================================
   ESTILOS GLOBALES NECESARIOS
   ========================================= */

/* Foco de Accesibilidad */
a:focus,
button:focus,
input:focus {
   outline: none;
   box-shadow: 0 0 0 var(--ancho-anillo-foco) var(--color-anillo-foco);
   border-radius: var(--radio-pequeno);
}

/* Clase para el Skip Link */
.skip-link {
   position: absolute;
   top: -100px;
   left: 50%;
   transform: translateX(-50%);
   background: var(--color-primario);
   color: var(--color-blanco);
   padding: 12px 24px;
   z-index: 9999;
   border-radius: 0 0 var(--radio-medio) var(--radio-medio);
   text-decoration: none;
   font-weight: 600;
   transition: top 0.3s ease;
}

.skip-link:focus {
   top: 0;
}

/* ==========================================================================
   GUÍA DE PROGRAMACIÓN Y UX (RECORDATORIOS)
   ==========================================================================
      
   1. ESTRUCTURA LARAVEL (app.blade.php):
      - Colocar el <a href="#contenido-principal" class="skip-link"> justo tras el <body>.
      - El <main> debe tener id="contenido-principal" y tabindex="-1".

   2. ACCESIBILIDAD (ARIA & SEMÁNTICA):
      - Portadas de libros: alt="Portada del libro: [Título]" (o alt="" si es decorativa).
      - Formularios: Todo <input> DEBE tener un <label> asociado por ID.
      - Errores de validación: No solo usar color, añadir texto descriptivo "Error: ...".
      - Jerarquía: Usar H1, H2, H3 en orden lógico, no por tamaño estético.

   3. DISEÑO DE COMPONENTES:
      - Textos pequeños: Usar --color-primario-oscuro para asegurar contraste AA (4.5:1).
      - Cuerpo de texto: Mantener siempre mínimo 16px.
      - Cards: Usar --transformacion-hover-card para feedback visual premium.
      */
