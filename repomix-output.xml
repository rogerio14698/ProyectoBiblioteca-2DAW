<file path="public/css/panelAdmin/gestionarCatalogo.css">
/* Estilos para la página de gestión del catálogo - Panel Admin */

/* === CONTENEDOR PRINCIPAL === */
.gestionCatalogoPageAdmin {
    background: var(--blanco);
    padding: 20px;
}

.gestionCatalogoPageAdmin h1 {
    color: var(--color-primario);
    margin-bottom: calc(var(--unidad-espaciado) * 0.5);
}

.gestionCatalogoPageAdmin > p {
    color: var(--color-texto-principal);
    margin-bottom: calc(var(--unidad-espaciado) * 2);
}

/* Alertas de éxito y error tras operaciones CRUD */
.alertaExitoAdmin {
    background-color: var(--color-exito);
    color: var(--color-blanco);
    padding: 10px 16px;
    border-radius: var(--radio-borde);
    margin-bottom: 16px;
    font-weight: 600;
}

.alertaErrorAdmin {
    background-color: var(--color-error);
    color: var(--color-blanco);
    padding: 10px 16px;
    border-radius: var(--radio-borde);
    margin-bottom: 16px;
    font-weight: 600;
}

/* Error de campo de validación */
.errorCampoAdmin {
    color: var(--color-error);
    margin-top: 2px;
}

/* === LAYOUT 2 COLUMNAS === */
.catalogoLayoutAdmin {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 24px;
    margin-top: 16px;
}

/* === COLUMNA IZQUIERDA: FORMULARIO === */
.catalogoFormularioColAdmin {
    align-self: start;
}

.catalogoFormularioColAdmin h2,
.catalogoListadoColAdmin h2 {
    color: var(--color-primario);
    margin-bottom: 12px;
}

/* === COLUMNA DERECHA: LISTADO === */
.catalogoListadoColAdmin {
    display: flex;
    flex-direction: column;
}

/* Filtros de búsqueda en una fila compacta */
.catalogoFiltrosAdmin {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 12px;
    align-items: center;
}

.catalogoFiltrosAdmin input,
.catalogoFiltrosAdmin select {
    padding: var(--input-relleno);
    border: 1px solid var(--color-borde-input);
    border-radius: var(--radio-borde);
    font-size: 0.82rem;
    flex: 1;
    min-width: 100px;
}

.btnFiltrarAdmin {
    /* Antes var(--color-primario): 3.3:1 con texto blanco, no llega al mínimo AA */
    background-color: var(--admin-color-primario);
    color: var(--color-blanco);
    border: none;
    padding: 6px 14px;
    border-radius: var(--radio-borde);


    font-weight: 600;
    transition: background-color 0.2s;
}

.btnFiltrarAdmin:hover {
    background-color: var(--admin-color-primario-hover);
}

.btnFiltrarAdmin:focus-visible {
    outline: 3px solid var(--admin-color-foco);
    outline-offset: 2px;
}

.btnLimpiarFiltrosAdmin {
    color: var(--color-texto-mutado);
    font-size: 0.82rem;
    text-decoration: underline;
    cursor: pointer;
}

/* Contenedor scrolleable para las cards (80vh de alto) */
.catalogoListadoScrollAdmin {
    max-height: 80vh;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-right: 8px;
}

/* Scrollbar sutil */
.catalogoListadoScrollAdmin::-webkit-scrollbar {
    width: 6px;
}

.catalogoListadoScrollAdmin::-webkit-scrollbar-thumb {
    background: var(--color-borde);
    border-radius: 3px;
}

/* === CARD DE LIBRO === */
.catalogoCardAdmin {
    display: grid;
    grid-template-columns: 90px 1fr auto;
    gap: 12px;
    align-items: center;
    background: var(--color-blanco);
    border: 1px solid var(--color-borde);
    border-radius: var(--radio-borde);
    padding: 10px 14px;
    box-shadow: var(--sombra-suave);
    transition: box-shadow 0.2s;
}

.catalogoCardAdmin:hover {
    box-shadow: var(--sombra-media);
}

/* Imagen de portada en la card */
.catalogoCardImgAdmin {
    width: 80px;
    height: 100px;
    overflow: hidden;
    border-radius: 4px;
    flex-shrink: 0;
}

.catalogoCardImgAdmin img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

/* Información del libro en la card */
.catalogoCardInfoAdmin h3 {
    font-size: 0.95rem;
    color: var(--color-texto-principal);
    margin-bottom: 4px;
}

.catalogoCardInfoAdmin p {
    font-size: 0.8rem;
    color: var(--color-texto-mutado);
    margin: 1px 0;
}

/* Badges de metadatos (año, formato, disponibilidad, ejemplares) */
.catalogoCardMetaAdmin {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    margin-top: 6px;
}

.catalogoCardMetaAdmin span {
    font-size: 0.72rem;
    padding: 2px 8px;
    border-radius: 10px;
    font-weight: 600;
}

.catalogoCardAnioAdmin {
    background: var(--color-fondo-global);
    color: var(--color-texto-principal);
}

/* Badge de formato según tipo */
.catalogoCardFormatoAdmin--fisico {
    /* Antes var(--bgFormatoFisico) (#fc9712): 2.2:1 con texto blanco.
       Usamos un naranja más oscuro solo aquí (variable global reutilizada en el catálogo
       público, que no debemos tocar) para cumplir 4.5:1. */
    background: #B45309;
    color: var(--color-blanco);
}

.catalogoCardFormatoAdmin--digital {
    background: var(--bgFormatoDigital);
    color: var(--color-blanco);
}

.catalogoCardFormatoAdmin--ambos {
    /* Antes var(--color-primario): 3.3:1 con texto blanco */
    background: var(--admin-color-primario);
    color: var(--color-blanco);
}

/* Badge de disponibilidad según estado */
.catalogoCardDisponibilidadAdmin--disponible {
    background: var(--bgDisponible);
    color: var(--color-blanco);
}

.catalogoCardDisponibilidadAdmin--prestado {
    background: var(--bgNoDisponible);
    color: var(--color-blanco);
}

.catalogoCardEjemplaresAdmin {
    background: var(--color-borde);
    color: var(--color-texto-principal);
}

/* Botón eliminar dentro de la card */
.catalogoCardAccionesAdmin {
    gap: 5px;
    display: flex;
    align-items: center;
}

.btnEliminarCatalogoAdmin {
    background-color: var(--bgBtnRojo);
    color: var(--color-blanco);
    border: none;
    padding: 6px 12px;
    border-radius: var(--radio-borde);
    cursor: pointer;
    font-weight: 600;

}

.btnEliminarCatalogoAdmin:hover {
    background-color: var(--bgBtnRojoHover);
}

.btnEliminarCatalogoAdmin:focus-visible,
.btnEditarCatalogoAdmin:focus-visible {
    outline: 3px solid var(--admin-color-foco);
    outline-offset: 2px;
}

/* Botón editar dentro de la card */
.btnEditarCatalogoAdmin {
    /* Antes var(--bgBtnAzul) (#17a2b8): 3.1:1 con texto blanco, no llega al mínimo AA */
    background-color: var(--admin-color-primario);
    color: var(--color-blanco);
    border: none;
    padding: 6px 12px;
    border-radius: var(--radio-borde);
    cursor: pointer;
    font-size: 0.8rem;
    font-weight: 600;
    transition: background-color 0.2s;
}

.btnEditarCatalogoAdmin:hover {
    background-color: var(--bgBtnAzulHover);
}

/* Miniatura de portada actual en modo edición */
.catalogoPortadaPreviewAdmin {
    width: 60px;
    height: 80px;
    object-fit: cover;
    border-radius: 4px;
    margin-top: 6px;
    border: 1px solid var(--color-borde);
}

/* Botones del formulario (enviar + cancelar) */
.catalogoFormBotonesAdmin {
    display: flex;
    gap: 8px;
    align-items: center;
    margin-top: 8px;
}

/* Botón cancelar edición */
.btnCancelarEdicionAdmin {
    color: var(--color-texto-mutado);
    font-size: 0.85rem;
    text-decoration: underline;
    cursor: pointer;
}

/* Mensaje cuando no hay libros */
.catalogoVacioAdmin {
    text-align: center;
    color: var(--color-texto-mutado);
    padding: 40px 0;
    font-size: 0.95rem;
}

/* Paginación fuera del scroll */
.catalogoPaginacionAdmin {
    margin-top: 12px;
    display: flex;
    justify-content: center;
}

/* === RESPONSIVE === */
@media (max-width: 768px) {
    .catalogoLayoutAdmin {
        grid-template-columns: 1fr;
    }

    .catalogoFiltrosAdmin {
        flex-direction: column;
    }

    .catalogoFiltrosAdmin input,
    .catalogoFiltrosAdmin select {
        width: 100%;
    }

    .catalogoCardAdmin {
        grid-template-columns: 60px 1fr;
    }

    .catalogoCardAccionesAdmin {
        grid-column: 1 / -1;
        justify-content: flex-end;
    }

    .catalogoListadoScrollAdmin {
        max-height: 60vh;
    }
}
