.librosPerdidosGrupoForm input {
    padding: calc(var(--unidad-espaciado) * 1) calc(var(--unidad-espaciado) * 1.5);
    border: 1px solid var(--color-borde-input);
    border-radius: 6px;
    font-size: 0.92rem;
    font-family: var(--fuente-familia);
    background: var(--blanco);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
}

.librosPerdidosGrupoForm input:focus {
    outline: none;
    border-color: var(--color-primario);
    box-shadow: 0 0 0 3px rgba(74, 144, 226, 0.15);
}

/* Boton de enviar formulario */
.librosPerdidosBotonEnvio {
    padding: calc(var(--unidad-espaciado) * 1.5);
    /* Antes var(--color-primario): 3.3:1 con texto blanco */
    background: var(--admin-color-primario);
    color: var(--blanco);
    border: none;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    margin-top: 10px;
    transition: background 0.2s ease, transform 0.15s ease, box-shadow 0.2s ease;
}

.librosPerdidosBotonEnvio:hover {
    background: var(--admin-color-primario-hover);
    box-shadow: var(--sombra-media);
    transform: translateY(-2px);
}

.librosPerdidosBotonEnvio:focus-visible {
    outline: 3px solid var(--admin-color-foco);
    outline-offset: 2px;
}

/* ==============================================
   LISTADO DE LIBROS PERDIDOS
   ============================================== */
.librosPerdidosListado h2 {
    color: var(--color-primario-oscuro);
    font-size: 1.2rem;
    margin-bottom: calc(var(--unidad-espaciado) * 2);
    padding-bottom: calc(var(--unidad-espaciado) * 1);
    border-bottom: 1px solid var(--color-borde);
}

/* Contenedor scrollable con tarjetas */
.librosPerdidosCards {
    display: flex;
    flex-direction: column;
    gap: calc(var(--unidad-espaciado) * 2);
    max-height: 55vh;
    overflow-y: auto;
    padding-right: calc(var(--unidad-espaciado) * 1);
    scrollbar-width: thin;
    scrollbar-color: var(--color-primario) transparent;
}

/* ==============================================
   TARJETA INDIVIDUAL DE LIBRO PERDIDO
   ============================================== */
.libroPerdidoCard {
    display: flex;
    align-items: center;
    gap: calc(var(--unidad-espaciado) * 2);
    background: var(--blanco);
    border: 1px solid var(--color-borde);
    border-left: 4px solid var(--bgBtnRojo);
    border-radius: 0 8px 8px 0;
    padding: calc(var(--unidad-espaciado) * 2);
    box-shadow: var(--sombra-suave);
    transition: box-shadow 0.2s ease, transform 0.15s ease;
}

.libroPerdidoCard:hover {
    box-shadow: var(--sombra-media);
    transform: translateY(-2px);
}

/* Bloque de informacion */
.libroPerdidoCardInfo {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: calc(var(--unidad-espaciado) * 0.75);
}

/* Titulo del libro */
.libroPerdidoCardTitulo {
    color: var(--color-texto-principal);
    font-size: 1rem;
    font-weight: 600;
    margin: 0;
}

/* Autor */
.libroPerdidoCardAutor {
    /* var(--color-primario) da 3.3:1 sobre blanco; el tono oscuro ya definido cumple AA */
    color: var(--color-primario-oscuro);
    font-size: 0.88rem;
    font-weight: 500;
}

/* Motivo de baja */
.libroPerdidoCardMotivo {
    color: var(--color-texto-mutado);
    font-size: 0.88rem;
    font-style: italic;
    margin: 0;
}

/* Fila de metadatos (fecha, ISBN) */
.libroPerdidoCardMeta {
    display: flex;
    flex-wrap: wrap;
    gap: calc(var(--unidad-espaciado) * 1.5);
    margin-top: calc(var(--unidad-espaciado) * 0.5);
}

.libroPerdidoCardMetaItem {
    font-size: 0.8rem;
    color: var(--color-texto-mutado);
    background: var(--color-card-evento);
    padding: 2px 10px;
    border-radius: 10px;
    white-space: nowrap;
}

/* Mensaje cuando no hay libros perdidos */
.libroPerdidoCardVacio {
    text-align: center;
    color: var(--color-texto-mutado);
    padding: calc(var(--unidad-espaciado) * 4) 0;
    font-size: 0.95rem;
}

/* ==============================================
   RESPONSIVE: Tablet (menos de 992px)
   ============================================== */
@media (max-width: 992px) {
    .librosPerdidosCards {
        max-height: 45vh;
    }
}

/* ==============================================
   RESPONSIVE: Movil (menos de 600px)
   ============================================== */
@media (max-width: 600px) {
    .gestionLibrosPerdidos {
        padding: var(--relleno-movil);
    }

    .libroPerdidoCard {
        flex-direction: column;
        align-items: flex-start;
    }

    .libroPerdidoCardMeta {
        flex-direction: column;
        gap: calc(var(--unidad-espaciado) * 0.5);
    }
}
</file>

<file path="public/css/panelAdmin/gestionarLibrosPrestadosContenedor.css">
/* ==============================================
   PAGINA: Gestionar Libros Prestados
   Layout: Encabezado + Listado de tarjetas con acciones
   Sigue el patron de gestionarLibrosPerdidos.css
   ============================================== */

/* --- Contenedor principal de la pagina --- */
.gestionPrestamos {
    display: flex;
    flex-direction: column;
    background: var(--blanco);
    padding: calc(var(--unidad-espaciado) * 3);
    gap: calc(var(--unidad-espaciado) * 3);
}

/* --- Encabezado superior con titulo y enlace --- */
.prestamosEncabezado {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: calc(var(--unidad-espaciado) * 2);
    flex-wrap: wrap;
}

.prestamosEncabezado h1 {
    color: var(--color-primario-oscuro);
    margin-bottom: calc(var(--unidad-espaciado) * 0.5);
}

.prestamosEncabezado p {
    color: var(--color-texto-mutado);
    font-size: 0.95rem;
}

/* Boton de navegacion a libros perdidos */
.prestamosNav .btn-base {
    white-space: nowrap;
}

/* --- Alertas de feedback --- */
.gestionPrestamos .alertaExito {
    background: var(--color-exito);
    color: var(--blanco);
    padding: calc(var(--unidad-espaciado) * 1.5);
    border-radius: 6px;
    font-weight: 600;
    font-size: 0.92rem;
}

.gestionPrestamos .alertaError {
    background: var(--color-error);
    color: var(--blanco);
    padding: calc(var(--unidad-espaciado) * 1.5);
    border-radius: 6px;
    font-weight: 600;
    font-size: 0.92rem;
}

/* ==============================================
   LISTADO DE PRESTAMOS ACTIVOS
   ============================================== */
.prestamosListado h2 {
    color: var(--color-primario-oscuro);
    font-size: 1.2rem;
    margin-bottom: calc(var(--unidad-espaciado) * 2);
    padding-bottom: calc(var(--unidad-espaciado) * 1);
    border-bottom: 1px solid var(--color-borde);
}

/* Contenedor scrollable con tarjetas */
.prestamosListadoCards {
    display: flex;
    flex-direction: column;
    gap: calc(var(--unidad-espaciado) * 2);
    max-height: 55vh;
    overflow-y: auto;
    padding-right: calc(var(--unidad-espaciado) * 1);
    scrollbar-width: thin;
    scrollbar-color: var(--color-primario) transparent;
}

/* ==============================================
   TARJETA INDIVIDUAL DE PRESTAMO
   ============================================== */
.prestamoCard {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: calc(var(--unidad-espaciado) * 2);
    background: var(--blanco);
    border: 1px solid var(--color-borde);
    border-left: 4px solid var(--color-primario);
    border-radius: 0 8px 8px 0;
    padding: calc(var(--unidad-espaciado) * 2);
    box-shadow: var(--sombra-suave);
    transition: box-shadow 0.2s ease, transform 0.15s ease;
}

.prestamoCard:hover {
    box-shadow: var(--sombra-media);
    transform: translateY(-2px);
}

/* Bloque de informacion del prestamo */
.prestamoCardInfo {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: calc(var(--unidad-espaciado) * 0.75);
}

/* Cabecera: ID + titulo del libro */
.prestamoCardCabecera {
    display: flex;
    align-items: center;
    gap: calc(var(--unidad-espaciado) * 1);
}

.prestamoCardId {
    font-size: 0.8rem;
    color: var(--color-texto-mutado);
    background: var(--color-card-evento);
    padding: 2px 10px;
    border-radius: 10px;
    white-space: nowrap;
}

.prestamoCardTitulo {
    color: var(--color-texto-principal);
    font-size: 1rem;
    font-weight: 600;
    margin: 0;
}

/* ISBN del libro */
.prestamoCardIsbn {
    font-size: 0.85rem;
    color: var(--color-texto-mutado);
}

/* Nombre del usuario que tiene el prestamo */
.prestamoCardUsuario {
    /* var(--color-primario) da 3.3:1 sobre blanco; el tono oscuro ya definido cumple AA */
    color: var(--color-primario-oscuro);
    font-size: 0.88rem;
    font-weight: 500;
    margin: 0;
}

/* Fila de metadatos (fechas) */
.prestamoCardMeta {
    display: flex;
    flex-wrap: wrap;
    gap: calc(var(--unidad-espaciado) * 1.5);
    margin-top: calc(var(--unidad-espaciado) * 0.5);
}

.prestamoCardMetaItem {
    font-size: 0.8rem;
    color: var(--color-texto-mutado);
    background: var(--color-card-evento);
    padding: 2px 10px;
    border-radius: 10px;
    white-space: nowrap;
}

/* ==============================================
   ACCIONES: Devolver y Marcar Perdido
   ============================================== */
.prestamoCardAcciones {
    display: flex;
    flex-direction: column;
    gap: calc(var(--unidad-espaciado) * 1);
    flex-shrink: 0;
}

/* Ajustes especificos para los botones dentro de la tarjeta */
.btnDevolverPrestamo,
.btnPerdidoPrestamo {
    width: 100%;
    white-space: nowrap;
    font-size: 0.88rem;
}

/* Mensaje cuando no hay prestamos activos */
.prestamoCardVacio {
    text-align: center;
    color: var(--color-texto-mutado);
    padding: calc(var(--unidad-espaciado) * 4) 0;
    font-size: 0.95rem;
}

/* ==============================================
   RESPONSIVE: Tablet (menos de 992px)
   ============================================== */
@media (max-width: 992px) {
    .prestamosListadoCards {
        max-height: 45vh;
    }

    .prestamosEncabezado {
        flex-direction: column;
    }
}

/* ==============================================
   RESPONSIVE: Movil (menos de 600px)
   ============================================== */
@media (max-width: 600px) {
    .gestionPrestamos {
        padding: var(--relleno-movil);
    }

    .prestamoCard {
        flex-direction: column;
        align-items: flex-start;
    }

    .prestamoCardAcciones {
        flex-direction: row;
        width: 100%;
    }

    .prestamoCardMeta {
        flex-direction: column;
        gap: calc(var(--unidad-espaciado) * 0.5);
    }

    .prestamoCardCabecera {
        flex-direction: column;
        align-items: flex-start;
        gap: calc(var(--unidad-espaciado) * 0.5);
    }
}
