<file path="public/css/panelAdmin/dashboard.css">
/* ==========================================================================
   DASHBOARD DEL ADMIN — rediseño minimalista
   Paleta y espaciados centralizados en variables.css (sección "PANEL DE
   ADMINISTRACIÓN"), así evitamos colores sueltos y mantenemos coherencia
   con el resto del panel.
   ========================================================================== */

.dashboard {
    padding: 24px;
    /* Fondo neutro y claro: más profesional que un bloque de color plano */
    background-color: var(--admin-color-fondo);
    color: var(--admin-color-texto);
}

.dashboardIntro {
    margin-bottom: 24px;
}

.dashboard h1 {
    color: var(--admin-color-texto);
    font-size: 1.9rem;
    font-weight: 700;
    margin: 0;
}

.dashboardSubtitulo {
    color: var(--admin-color-texto-mutado);
    font-size: 0.95rem;
    margin-top: 4px;
}

/* ==== Sección: Tarjetas de resumen (KPIs) ==== */
.dashboard-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 20px;
}

.cardElementosDashboard {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    padding: 20px;
    background-color: var(--admin-color-fondo-tarjeta);
    border: 1px solid var(--admin-color-borde);
    border-radius: 10px;
    box-shadow: var(--sombra-suave);
    transition: box-shadow 0.2s ease, transform 0.2s ease;
}

.cardElementosDashboard:hover {
    box-shadow: var(--sombra-media);
    transform: translateY(-2px);
}

/* Círculo de icono: el color distingue cada KPI sin depender solo del texto */
.cardIcono {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    font-size: 1.2rem;
    color: var(--color-blanco);
}

.cardIcono--azul { background-color: var(--admin-color-primario); }
.cardIcono--verde { background-color: var(--admin-color-secundario); }
.cardIcono--morado { background-color: #6D28D9; }
.cardIcono--naranja { background-color: #B45309; }

.cardTexto {
    display: flex;
    flex-direction: column;
}

.cardValor {
    font-size: 2rem;
    font-weight: 700;
    line-height: 1.1;
    color: var(--admin-color-texto);
}

.cardElementosDashboard h2 {
    margin: 4px 0 0;
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--admin-color-texto);
}

.cardElementosDashboard p {
    margin: 2px 0 0;
    font-size: 0.82rem;
    color: var(--admin-color-texto-mutado);
}

/* Enlace de texto en vez de botón sólido: más ligero y minimalista */
.cardEnlace {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-top: 8px;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--admin-color-primario);
    text-decoration: none;
}

.cardEnlace:hover {
    text-decoration: underline;
}

.cardEnlace:focus-visible {
    outline: 3px solid var(--admin-color-foco);
    outline-offset: 2px;
    border-radius: 3px;
}

/* ==== Sección: Listado de mensajes de contacto ==== */
.bodyDashboard {
    margin-top: 28px;
}

.dashboardListadoMail {
    width: auto;
    background-color: var(--admin-color-fondo-tarjeta);
    border: 1px solid var(--admin-color-borde);
    border-radius: 10px;
    box-shadow: var(--sombra-suave);
    overflow: hidden;
}

.cardHeaderMail {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 14px 18px;
    background-color: var(--admin-color-fondo-tarjeta);
    border-bottom: 1px solid var(--admin-color-borde);
}

.cardHeaderMail h5 {
    margin: 0;
    font-size: 1rem;
    font-weight: 700;
    color: var(--admin-color-texto);
}

.cardHeaderMail h5 i {
    color: var(--admin-color-primario);
    margin-right: 6px;
}

/* Contenedor principal para permitir scroll horizontal si la pantalla es muy pequeña */
.bodyListadoMail {
    width: 100%;
    overflow-y: auto;
    max-height: 80vh; /* Limita la altura para evitar que ocupe toda la pantalla */
}

.tablaListadoMail {
    display: flex;
    flex-direction: column;
}

/* Fila de Títulos y Fila de Datos */
.titulosListados, .dataListadoMail {
    display: grid;
    /* Columnas 100% fluidas en fr para adaptarse a cualquier ancho */
    /* Nombre | Email | Asunto | Mensaje | Fecha | Estado | Acciones */
    grid-template-columns: 0.7fr 0.8fr 1.1fr 1.5fr 0.5fr 0.4fr 0.9fr;
    align-items: center;
    padding: 12px 18px;
    gap: 12px;
}

/* Estilo de la cabecera: fondo claro con texto oscuro, más sobrio que un bloque de color */
.titulosListados {
    background-color: var(--admin-color-fondo);
    color: var(--admin-color-texto-mutado);
    font-weight: 700;
    text-transform: uppercase;
    font-size: 0.72rem;
    letter-spacing: 0.5px;
    border-bottom: 1px solid var(--admin-color-borde);
}

/* Estilo de las filas de datos - alternancia de color (zebra) para legibilidad */
.dataListadoMail {
    color: var(--admin-color-texto);
    background-color: var(--admin-color-fondo-tarjeta);
    border-bottom: 1px solid var(--admin-color-borde);
    transition: background 0.2s;
}

.dataListadoMail:hover {
    background-color: var(--admin-color-fondo);
}

.dataListadoMail:last-child {
    border-bottom: none;
}

/* --- EL MENSAJE CON SCROLL --- */
.dataMensaje, .dataNombre, .dataAsunto, .dataEmail {
    max-height: 60px; /* Altura máxima antes de hacer scroll */
    overflow-y: auto; /* Scroll vertical si el texto es largo */
    padding-right: 5px;
    font-size: 0.88rem;
    line-height: 1.4;
    color: var(--admin-color-texto);
    /* Estilo barra de scroll fina */
    scrollbar-width: thin;
}

/* Estilo de los botones de acciones: fila compacta tipo "toolbar" */
.dataListadoMail span:last-child {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    align-items: center;
}



/* Select de estado estilizado */
.selectEstadoMail {
    font-size: 0.76rem;
    padding: 5px 8px;
    border: 1px solid var(--admin-color-borde);
    border-radius: 6px;
    background-color: var(--admin-color-fondo-tarjeta);
    color: var(--admin-color-texto);
    cursor: pointer;
    outline: none;
}

.selectEstadoMail:focus {
    border-color: var(--admin-color-primario);
    /* Foco visible con anillo de color, necesario para navegación por teclado (WCAG) */
    outline: 3px solid var(--admin-color-foco);
    outline-offset: 1px;
    box-shadow: 0 0 0 2px rgba(29, 78, 216, 0.2);
}

/* Estados */
.estadoMail {
    padding: 4px 10px;
    border-radius: 12px;
    font-size: 0.76rem;
    font-weight: 700;
    text-align: center;
    white-space: nowrap;
}

.estadoPendiente {
    /* Antes #ffeaa7/#d35400 (3.5:1, no llega al 4.5:1 exigido para texto normal) */
    background-color: var(--admin-badge-advertencia-bg);
    color: var(--admin-badge-advertencia-texto);
}

.estadoProceso {
    background-color: var(--admin-badge-neutro-bg);
    color: var(--admin-badge-neutro-texto);
}

.estadoLeido {
    /* Antes #55efc4/#00b894 (1.8:1, muy por debajo del mínimo accesible) */
    background-color: var(--admin-badge-exito-bg);
    color: var(--admin-badge-exito-texto);
}

/* --- Formulario de respuesta al mail --- */

/* Clase auxiliar para ocultar elementos con JS */
.oculto {
    display: none;
}

/* Contenedor del formulario de respuesta dentro de cada fila */
.formResponderMail {
    grid-column: 1 / -1;
    padding: 12px 18px;
    background-color: var(--admin-color-fondo);
    border-top: 1px solid var(--admin-color-borde);
}

.formResponderMail label {
    display: block;
    font-size: 0.85rem;
    color: var(--admin-color-texto-mutado);
    margin-bottom: 6px;
}
.btnsAccionesDashboard{
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    align-items: center;
}


/* Textarea de respuesta */
.textareaResponderMail {
    width: 100%;
    padding: 10px;
    font-size: 0.88rem;
    border: 1px solid var(--admin-color-borde);
    border-radius: 6px;
    resize: vertical;
    font-family: var(--fuente-familia);
    margin-bottom: 8px;
    outline: none;
}

.textareaResponderMail:focus {
    border-color: var(--admin-color-primario);
    outline: 2px solid var(--admin-color-foco);
    outline-offset: 1px;
}


@media (max-width: 768px) {
    .dashboard-cards {
        margin-bottom: 0;
    }

    .dashboard-body {
        grid-template-columns: 1fr;
        padding-top: 20px;
    }

    /* --- TABLA DE MAILS: diseño tipo tarjeta en móvil --- */

    /* Eliminamos el min-width para que no fuerce scroll horizontal */
    .tablaListadoMail {
        min-width: unset;
    }

    /* Ocultamos la cabecera de columnas en móvil */
    .titulosListados {
        display: none;
    }

    /* Cada fila de datos se convierte en una tarjeta apilada */
    .dataListadoMail {
        display: flex;
        flex-direction: column;
        gap: 8px;
        padding: var(--relleno-movil, 12px);
        margin-bottom: 12px;
        border-radius: var(--radio-borde);
        border-bottom: none;
        box-shadow: var(--sombra-suave);
    }

    /* Etiquetas visibles en móvil mediante ::before con el nombre del campo */
    .dataListadoMail .dataNombre::before,
    .dataListadoMail .dataEmail::before,
    .dataListadoMail .dataAsunto::before,
    .dataListadoMail .dataMensaje::before,
    .dataListadoMail .dataFecha::before,
    .dataListadoMail .dataEstado::before {
        display: block;
        font-weight: bold;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: var(--admin-color-primario);
        margin-bottom: 2px;
    }

    .dataListadoMail .dataNombre::before { content: "Nombre"; }
    .dataListadoMail .dataEmail::before { content: "Email"; }
    .dataListadoMail .dataAsunto::before { content: "Asunto"; }
    .dataListadoMail .dataMensaje::before { content: "Mensaje"; }
    .dataListadoMail .dataFecha::before { content: "Fecha"; }
    .dataListadoMail .dataEstado::before { content: "Estado"; }

    /* Los campos de texto recuperan su altura completa en movil */
    .dataMensaje, .dataNombre, .dataAsunto, .dataEmail {
        max-height: none;
        overflow-y: visible;
    }

    /* Los botones de acciones se apilan en columna */
    .dataListadoMail span:last-child {
        flex-direction: column;
        gap: 8px;
        padding-top: 8px;
        border-top: 1px solid var(--admin-color-borde);
    }
}
</file>

<file path="public/css/variables/botones.css">
/* ============================================
   BOTONES - Sistema modular de botones
   ============================================ */

/* ---- 1. BASE: Estilos comunes a TODOS los botones ---- */
.btn-base {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 5px 10px;
    font-family: var(--fuente-familia);
    font-weight: 500;
    border-radius: 3px;
    transition: all 0.3s ease;
    cursor: pointer;
    border: 1px solid transparent;
    text-decoration: none;
}

/* ---- 2. GRUPO: Botones de color de ancho completo ---- */
/* Estilos compartidos por verde, azul, amarillo, rojo, ver, carrito, alquilar */
.btn-verde,
.btn-azul,
.btn-amarillo,
.btn-rojo,
.btn-ver,
.btn-carrito,
.btn-alquilar {
    width: 100%;
    color: var(--color-blanco);
}

/* Hover compartido: sombra */
.btn-verde:hover,
.btn-azul:hover,
.btn-amarillo:hover,
.btn-rojo:hover,
.btn-ver:hover,
.btn-carrito:hover,
.btn-alquilar:hover {
    box-shadow: var(--sombra);
}

/* Active compartido: elevación */
.btn-verde:active,
.btn-azul:active,
.btn-amarillo:active,
.btn-rojo:active {
    transform: translateY(-2px);
}

/* Active compartido: elevación suave (catálogo) */
.btn-ver:active,
.btn-carrito:active,
.btn-alquilar:active {
    transform: translateY(-1px);
}

/* ---- 3. VARIANTES DE COLOR: solo background ---- */

/* Verde (Acción principal / Confirmar) */
.btn-verde {
    background-color: var(--bgBtnVerde);
}
.btn-verde:hover {
    background-color: var(--bgBtnVerdeHover);
}

/* Azul (Información / Ver más) */
.btn-azul {
    background-color: var(--bgBtnAzul);
}
.btn-azul:hover {
    background-color: var(--bgBtnAzulHover);
}

/* Amarillo (Aviso / Atención) */
.btn-amarillo {
    background-color: var(--colorComplementarioTerciario);
}
.btn-amarillo:hover {
    background-color: var(--colorComplementarioTerciarioHover);
}

/* Rojo (Peligro / Eliminar) */
.btn-rojo {
    background-color: var(--bgBtnRojo);
}
.btn-rojo:hover {
    background-color: var(--bgBtnRojoHover);
}

/* ---- 4. VARIANTES CATÁLOGO ---- */

/* Ver detalles */
.btn-ver {
    background-color: var(--color-primario-oscuro);
}
.btn-ver:hover {
    background-color: var(--color-primario);
}

/* Añadir al carrito */
.btn-carrito {
    background-color: var(--color-carrito-anadir);
}

/* Alquilar */
.btn-alquilar {
    background-color: var(--color-alquilar);
}

/* ---- 5. BOTONES ESPECIALES (Primario, Turquesa, Admin) ---- */

/* Primario (Azul institucional) */
.btn-primario {
    background-color: var(--color-primario);
    color: var(--color-blanco);
}
.btn-primario:hover {
    background-color: var(--color-primario-oscuro);
    transform: translateY(-1px);
    box-shadow: var(--sombra);
}

/* Turquesa (Acento secundario) */
.btn-turquesa {
    background-color: var(--color-secundario);
    color: var(--color-texto-principal);
}

/* Admin (Outline / borde) */
.btn-admin {
    background-color: transparent;
    border: 2px solid var(--color-primario);
    color: var(--color-primario);
}
.btn-admin:hover {
    background-color: var(--color-primario);
    color: var(--color-blanco);
}

/* ---- 6. BOTÓN LOGOUT ---- */
.btn-logout {
    background-color: var(--color-primario);
    color: var(--color-blanco);
    border: none;
    padding: 5px 10px;
    border-radius: var(--radio-medio);
    cursor: pointer;
}
.btn-logout:hover {
    background-color: var(--color-primario-oscuro);
    transform: translateY(-1px);
    box-shadow: var(--sombra);
}

/* ---- 7. BOTÓN MENÚ HAMBURGUESA ---- */
.btnMenu {
    display: block;
    background: none;
    border: none;
    font-size: 2rem;
    color: var(--color-primario);
    cursor: pointer;
    padding: 5px;
}

/* Los estilos de .btn-slider están centralizados en btnSlider.css */

/* ---- 8. BOTONES BUSCADOR CATÁLOGO ---- */
.btn-buscar,
.btn-limpiar {
    min-height: var(--altura-boton-movil);
    padding: 0 calc(var(--unidad-espaciado) * 2);
}

.btn-buscar {
    background-color: var(--color-primario);
    color: var(--color-blanco);
}
.btn-buscar:hover {
    background-color: var(--color-primario-oscuro);
}

.btn-limpiar {
    background-color: var(--color-blanco);
    color: var(--color-primario-oscuro);
    border: 1px solid var(--color-primario-oscuro);
    text-decoration: none;
}
.btn-limpiar:hover {
    background-color: var(--color-fondo-global);
}

/* ---- 9. GRUPO: Botones Mail Admin ---- */
/* Estilos compartidos por eliminar, cambiar estado y responder: chips compactos
   en fila (no width:100%) para el diseño de tarjeta de mensaje minimalista */
.btnEliminarMail,
.btnCambiarEstadoMail,
.btnResponderMail {
    color: var(--color-blanco);
    font-size: 0.76rem;
    padding: 6px 12px;
    border-radius: 6px;
    font-weight: 600;
    border: none;
    cursor: pointer;
}

.btnEliminarMail:hover,
.btnCambiarEstadoMail:hover,
.btnResponderMail:hover {
    box-shadow: var(--sombra-suave);
}

/* Variantes de color mail */
.btnEliminarMail {
    background-color: var(--bgBtnRojo);
}
.btnEliminarMail:hover {
    background-color: var(--bgBtnRojoHover);
}

.btnCambiarEstadoMail {
    /* Antes var(--color-primario): 3.3:1 con texto blanco, no llega al mínimo AA (4.5:1) */
    background-color: var(--admin-color-primario);
}
.btnCambiarEstadoMail:hover {
    background-color: var(--admin-color-primario-hover);
}
.btnCambiarEstadoMail:focus-visible,
.btnEliminarMail:focus-visible,
.btnResponderMail:focus-visible {
    outline: 3px solid var(--admin-color-foco);
    outline-offset: 2px;
}

.btnResponderMail {
    background-color: var(--bgBtnVerde);
}
.btnResponderMail:hover {
    background-color: var(--bgBtnVerdeHover);
}
