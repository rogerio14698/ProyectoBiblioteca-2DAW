        grid-column: 1 / -1;
    }
}

/* Mensaje de éxito tras crear evento */
.alertaExito {
    padding: calc(var(--unidad-espaciado) * 1.5);
    background-color: var(--color-exito-fondo, #d4edda);
    color: var(--color-exito-texto, #155724);
    border: 1px solid var(--color-exito-borde, #c3e6cb);
    border-radius: var(--radio-medio);
    font-size: 1rem;
    line-height: var(--fuente-altura-linea);
}

/* Mensaje de error debajo de cada campo */
.errorCampo {
    color: var(--color-error, #dc3545);
    font-size: 0.85rem;
    margin-top: 2px;
}

/* Texto de ayuda debajo del campo de imagen */
.ayudaCampo {
    color: var(--color-texto-secundario, #666);
    font-size: 0.85rem;
    margin-top: 2px;
}

/* Texto cuando no hay inscripciones */
.textoVacio {
    color: var(--color-texto-secundario, #666);
    font-style: italic;
}

/* ============================================
   LISTADO DE INSCRIPCIONES (grid imitando tabla)
   ============================================ */

/* Cabecera visible solo en desktop */
.inscripcionCabecera {
    display: none;
}

/* Cada fila/card de inscripción */
.inscripcionFila {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: calc(var(--unidad-espaciado) * 1.5);
    border: 1px solid var(--colorBorde, #e0e0e0);
    border-radius: var(--radio-medio, 8px);
    background-color: var(--color-blanco, #fff);
    margin-bottom: calc(var(--unidad-espaciado) * 1);
    transition: box-shadow var(--transicion-rapida, 0.2s);
}

.inscripcionFila:hover {
    box-shadow: var(--sombra-media, 0 2px 8px rgba(0,0,0,0.12));
}

/* En móvil: etiqueta visible antes del valor */
.inscripcionCol::before {
    content: attr(data-label) ": ";
    font-weight: 600;
    color: var(--color-primario-oscuro, #1a3a5c);
}

/* La cabecera no lleva data-label, ocultamos su ::before */
.inscripcionCabecera .inscripcionCol::before {
    content: none;
}

/* Acciones: botones en fila */
.inscripcionCol--acciones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--unidad-espaciado, 8px);
}

/* En móvil la etiqueta "Acciones:" no ocupa toda la fila */
.inscripcionCol--acciones::before {
    flex-basis: auto;
    margin-right: 4px;
}

/* Form darse de baja inline, al lado del botón Ver */
.formDarseDeBaja {
    display: inline-flex;
    width: 100%;
}

/* ---- Desktop: grid imitando tabla ---- */
@media (min-width: 768px) {
    .inscripcionCabecera {
        display: grid;
        grid-template-columns: 2fr 1fr 0.7fr 1.5fr 1fr 1.5fr;
        gap: calc(var(--unidad-espaciado) * 1);
        padding: calc(var(--unidad-espaciado) * 1) calc(var(--unidad-espaciado) * 1.5);
        background-color: var(--color-primario-oscuro, #1a3a5c);
        color: var(--color-blanco, #fff);
        font-weight: 600;
        font-size: 0.9rem;
        border-radius: var(--radio-medio, 8px) var(--radio-medio, 8px) 0 0;
    }

    .inscripcionFila {
        display: grid;
        grid-template-columns: 2fr 1fr 0.7fr 1.5fr 1fr 1.5fr;
        gap: calc(var(--unidad-espaciado) * 1);
        align-items: center;
        flex-direction: row;
        border-radius: 0;
        margin-bottom: 0;
        border-top: none;
        border-left: 1px solid var(--colorBorde, #e0e0e0);
        border-right: 1px solid var(--colorBorde, #e0e0e0);
        border-bottom: 1px solid var(--colorBorde, #e0e0e0);
    }

    .inscripcionFila:last-child {
        border-radius: 0 0 var(--radio-medio, 8px) var(--radio-medio, 8px);
    }

    /* En desktop no mostramos la etiqueta data-label */
    .inscripcionCol::before {
        content: none;
    }

    .inscripcionCol--acciones::before {
        display: none;
    }

    .inscripcionCol--acciones {
        flex-basis: auto;
    }
}

/* Badges de estado de inscripción */
.estadoInscripcion {
    display: inline-block;
    padding: 3px 10px;
    border-radius: var(--radio-pequeno, 4px);
    font-size: 0.8rem;
    font-weight: 600;
    white-space: nowrap;
}

.estadoInscripcion--inscrito {
    background-color: #d4edda;
    color: #155724;
}

.estadoInscripcion--asistido {
    background-color: #cce5ff;
    color: #004085;
}

.estadoInscripcion--cancelado {
    background-color: #f8d7da;
    color: #721c24;
}

.estadoInscripcion--no_asistio {
    background-color: #fff3cd;
    color: #856404;
}
