        /* --- Filtros aplicados --- */
        .informeFiltros {
            background: #f5f5f5;
            border: 1px solid #ddd;
            border-radius: 4px;
            padding: 8px 14px;
            margin-bottom: 16px;
            font-size: 10px;
            color: #444;
        }

        .informeFiltros strong {
            color: #222;
        }

        /* --- Resumen rápido --- */
        .informeResumen {
            display: flex;
            gap: 16px;
            flex-wrap: wrap;
            margin-bottom: 16px;
            padding: 8px 0;
            border-bottom: 1px solid #ccc;
        }

        .informeResumen span {
            font-size: 10px;
