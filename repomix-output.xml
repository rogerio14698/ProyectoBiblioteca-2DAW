    margin-top: calc(var(--unidad-espaciado) * 1.5);
}

.publicacionesAcademicasPage {
    display: flex;
    flex-direction: column;
    gap: calc(var(--unidad-espaciado) * 2);
}

.publicacionesAcademicasFiltros {
    display: flex;
    flex-direction: column;
    gap: calc(var(--unidad-espaciado) * 1);
    width: 100%;
    margin-top: calc(var(--unidad-espaciado) * 1);
}

.publicacionesAcademicasListaWrap {
    background: var(--color-blanco);
    border: 1px solid var(--color-borde);
    box-shadow: var(--sombra-media);
    padding: calc(var(--unidad-espaciado) * 2);
}

.publicacionesAcademicasLista {
    display: flex;
    flex-direction: column;
}

.publicacionesAcademicasHeader,
.publicacionesAcademicasItem {
    display: grid;
    grid-template-columns: 1.4fr 2fr 0.8fr 0.8fr;
    gap: calc(var(--unidad-espaciado) * 1);
    align-items: center;
    padding: calc(var(--unidad-espaciado) * 1.25) 0;
}

.publicacionesAcademicasHeader {
    border-bottom: 2px solid var(--color-borde);
    font-weight: 700;
    color: var(--color-primario-oscuro);
}

.publicacionesAcademicasItem {
    border-bottom: 1px solid var(--color-borde);
}

.publicacionesAcademicasItem:last-child {
    border-bottom: none;
}

.publicacionesCampoNombre {
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.publicacionesCampoNombre small {
    color: var(--color-texto-mutado);
}

.publicacionesCampoTitulo,
.publicacionesCampoFecha {
    color: var(--color-texto-principal);
}

.publicacionesCampoAccion {
    display: flex;
    justify-content: flex-start;
}

.publicacionesCampoAccion .btn-base {
    width: auto;
    min-width: 120px;
}

.publicacionesAcademicasVacio {
    margin: 0;
    padding: calc(var(--unidad-espaciado) * 2) 0;
    color: var(--color-texto-mutado);
}

.paginacionPublicacionesAcademicas {
    margin-top: calc(var(--unidad-espaciado) * 2);
}

@media (max-width: 767px) {
    .publicacionesAcademicasHeader {
        display: none;
    }

    .publicacionesAcademicasItem {
        grid-template-columns: 1fr;
        gap: calc(var(--unidad-espaciado) * 0.75);
        border: 1px solid var(--color-borde);
        border-radius: var(--radio-pequeno);
        margin-bottom: calc(var(--unidad-espaciado) * 1);
        padding: calc(var(--unidad-espaciado) * 1.25);
    }

    .publicacionesCampoAccion {
        justify-content: flex-start;
    }
}

@media (min-width: 768px) {
    .publicacionesAcademicasFiltros {
        display: grid;
        grid-template-columns: 2fr 1fr 1fr auto auto;
        align-items: center;
    }
}
</file>

<file path="public/css/paneles/usuarioAutenticado/comprarLibrosUsuario.css">
.comprarLibros {
    display: flex;
    flex-direction: column;
    gap: calc(var(--unidad-espaciado) * 3);
    background-color: var(--bgPerfilUsuario);
    padding: calc(var(--unidad-espaciado) * 2);
}

.comprarHeader {
    display: flex;
    flex-direction: column;
    gap: calc(var(--unidad-espaciado) * 1.5);
    padding: calc(var(--unidad-espaciado) * 2);
    border: 1px solid var(--colorBorde);
    border-radius: var(--radio-medio);
    background-color: var(--color-blanco);
    box-shadow: var(--sombra-suave);
}

.comprarHeader h1 {
    margin: 0;
    color: var(--color-primario-oscuro);
    font-size: 1.9rem;
    text-decoration: underline;
}

.comprarHeader p {
    margin: 0;
    color: var(--color-texto-principal);
    font-size: 1rem;
    line-height: var(--fuente-altura-linea);
}

.comprarHeader span {
    color: var(--color-primario);
    font-weight: 700;
}

.comprarEstado {
    display: flex;
    justify-content: center;
}

.comprarEstadoCard {
    display: flex;
    flex-direction: column;
    gap: calc(var(--unidad-espaciado) * 2);
    width: 100%;
    padding: calc(var(--unidad-espaciado) * 3);
    border: 1px solid var(--colorBorde);
    border-left: 6px solid var(--color-carrito-anadir);
    border-radius: var(--radio-medio);
    background: linear-gradient(180deg, var(--color-blanco) 0%, var(--color-fondo-global) 100%);
    box-shadow: var(--sombra-media);
}

.comprarEstadoEtiqueta {
    width: fit-content;
    margin: 0;
    padding: 6px 12px;
    border-radius: 999px;
    background-color: var(--color-fondo-tag);
    color: var(--color-texto-tag);
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
}

.comprarEstadoCard h2 {
    margin: 0;
    color: var(--color-primario-oscuro);
    font-size: 1.5rem;
}

.comprarEstadoCard > p {
    margin: 0;
    color: var(--color-texto-principal);
    font-size: 1rem;
    line-height: var(--fuente-altura-linea);
}

.comprarEstadoLista {
    display: grid;
    gap: calc(var(--unidad-espaciado) * 1.5);
}

.comprarEstadoLista p {
    margin: 0;
    padding: calc(var(--unidad-espaciado) * 1.5);
    border: 1px solid var(--colorBorde);
    border-radius: var(--radio-pequeno);
    background-color: var(--color-blanco);
    color: var(--color-texto-principal);
    box-shadow: var(--sombra-suave);
}

@media (min-width: 768px) {
    .comprarLibros {
        gap: calc(var(--unidad-espaciado) * 4);
        padding: calc(var(--unidad-espaciado) * 3);
    }

    .comprarHeader {
        padding: calc(var(--unidad-espaciado) * 3);
    }

    .comprarEstadoCard {
        max-width: 820px;
        padding: calc(var(--unidad-espaciado) * 4);
    }

    .comprarEstadoLista {
        grid-template-columns: repeat(3, minmax(0, 1fr));
    }
}
</file>

<file path="public/css/variables/paginacion.css">
/* Contenedor principal */
.paginacionBase .pagination {
    display: flex;
    justify-content: center;
    list-style: none;
    padding: 0;
    gap: 8px;
    margin: 2rem 0;
}

/* Botones */
.paginacionBase .page-link {
    display: block;
    padding: 10px 16px;
    background-color: #ffffff;
    border: 1px solid #e0e0e0;
    border-radius: 8px; /* O tu variable var(--radio-pequeno) */
    text-decoration: none;
    transition: all 0.3s ease;
    font-weight: 500;
}

/* Estado deshabilitado (Común para todos) */
.paginacionBase .page-item.disabled .page-link {
    color: #ccc;
    pointer-events: none;
    background-color: #f9f9f9;
    border-color: #eee;
}

/*Fin de la paginación modular.*/

/* --- TEMA CATÁLOGO (Azul/Amazon) --- */
.paginacionCatalogo .page-link {
    color: #007185;
}

.paginacionCatalogo .page-item.active .page-link {
    background-color: #007185;
    color: white;
    border-color: #007185;
}

.paginacionCatalogo .page-link:hover:not(.active) {
    background-color: #f7fafa;
    border-color: #007185;
}

/* --- TEMA AGENDA (Verde/Calendario) --- */
.paginacionAgenda .page-link {
    color: #2e7d32;
}

.paginacionAgenda .page-item.active .page-link {
    background-color: #2e7d32;
    color: white;
    border-color: #2e7d32;
}

.paginacionAgenda .page-link:hover:not(.active) {
    background-color: #e8f5e9;
    border-color: #2e7d32;
}

/*Tema Noricias*/

/* --- TEMA NOTICIAS (Gris Oscuro / Rojo Informativo) --- */

/* Color de fuente y bordes para noticias */
.paginacionNoticias .page-link {
    color: #1a1a1a; /* Un gris casi negro, muy formal */
    border-color: #333;
    font-weight: 600;
}

/* Página activa: Usamos un rojo vibrante de "Breaking News" */
.paginacionNoticias .page-item.active .page-link {
    background-color: #d32f2f; 
    color: white;
    border-color: #d32f2f;
}

/* Efecto Hover: Cambio sutil de fondo */
.paginacionNoticias .page-link:hover:not(.active) {
    background-color: #1a1a1a;
    color: white;
    border-color: #1a1a1a;
}
</file>

<file path="public/css/variables/paginaMantenimiento.css">
.paginaEnObras {
    display: flex;
