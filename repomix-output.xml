<file path="public/css/panelAdmin/gestionarContenidoCatalogo.css">
/* Estilos para Gestión de Contenido del Catálogo - Panel Administrativo */

/* Sección Principal de Gestión */
.gestionCatalogo {
    display: flex;
    flex-direction: column;
    gap: calc(var(--unidad-espaciado) * 2);
    margin-bottom: calc(var(--unidad-espaciado) * 4);
    background: var(--blanco);
    padding: 20px;
}

.gestionCatalogo h1 {
    font-size: 26px;
    color: var(--color-primario-claro);
    font-weight: 600;
    border-bottom: 3px solid var(--color-primario);
    padding-bottom: var(--unidad-espaciado);
}

.gestionCatalogo > p {
    color: var(--color-texto-mutado);
    font-size: 14px;
}

/* Contenedor Formulario Añadir Libros */
.anadirLibrosCatalogo {
    background-color: var(--color-fondo-global);
    padding: calc(var(--unidad-espaciado) * 3);
    border-radius: var(--radio-medio);
    border-left: 4px solid var(--color-secundario);
    box-shadow: var(--sombra-media);
}

/* Formulario de Catálogo */
.anadirLibrosCatalogo form {
    display: flex;
    flex-direction: column;
    gap: calc(var(--unidad-espaciado) * 2);
}

/* Grupo de Campos del Formulario */
.labelFormCatalogo {
    display: flex;
    flex-direction: column;
    gap: calc(var(--unidad-espaciado) * 0.75);
}

.labelFormCatalogo label {
    color: var(--color-primario-claro);
    font-weight: 600;
    font-size: 14px;
}

/* Inputs del Formulario */
.labelFormCatalogo input[type="text"],
.labelFormCatalogo input[type="number"],
.labelFormCatalogo input[type="file"],
.labelFormCatalogo textarea,
.labelFormCatalogo select {
    width: 100%;
    padding: var(--input-relleno);
    border: 1px solid var(--input-borde);
    border-radius: var(--radio-pequeno);
    font-family: var(--fuente-familia);
    font-size: 14px;
    color: var(--color-texto-principal);
    background-color: var(--color-blanco);
    transition: all var(--transicion-rapida);
    box-sizing: border-box;
}

/* Focus de Inputs */
.labelFormCatalogo input[type="text"]:focus,
.labelFormCatalogo input[type="number"]:focus,
.labelFormCatalogo input[type="file"]:focus,
.labelFormCatalogo textarea:focus,
.labelFormCatalogo select:focus {
    outline: none;
    border-color: var(--color-primario);
    box-shadow: var(--input-foco-sombra);
}

/* Textarea */
.labelFormCatalogo textarea {
    resize: vertical;
    min-height: 100px;
}

/* Botón Envío */
.labelFormCatalogo button[type="submit"] {
    /* Antes var(--color-primario): 3.3:1 con texto blanco */
    background-color: var(--admin-color-primario);
    color: var(--color-blanco);
    border: none;
    padding: calc(var(--unidad-espaciado) * 1.5) calc(var(--unidad-espaciado) * 2);
    border-radius: var(--radio-pequeno);
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: all var(--transicion-rapida);
    width: 100%;
}

.labelFormCatalogo button[type="submit"]:hover {
    background-color: var(--admin-color-primario-hover);
    box-shadow: var(--sombra-media);
    transform: translateY(-2px);
}

.labelFormCatalogo button[type="submit"]:focus-visible {
    outline: 3px solid var(--admin-color-foco);
    outline-offset: 2px;
}

.labelFormCatalogo button[type="submit"]:active {
    transform: translateY(0);
}

/* Sección de Listado */
.gestionListado {
    display: flex;
    flex-direction: column;
    gap: calc(var(--unidad-espaciado) * 2);
    background: var(--blanco);
    padding: 20px;
}

.gestionListado h2 {
    font-size: 22px;
    color: var(--color-primario-claro);
    font-weight: 600;
    border-bottom: 2px solid var(--color-primario);
    padding-bottom: var(--unidad-espaciado);
}

.gestionListado > p {
    color: var(--color-texto-mutado);
    font-size: 14px;
}

/* Contenedor de Tabla con Scroll */
.gestionTablaBloqueador {
    overflow-x: auto;
    border-radius: var(--radio-pequeno);
    box-shadow: var(--sombra-suave);
}

/* Tabla de Catálogo */
.gestionTablaEventos {
    width: 100%;
    border-collapse: collapse;
    background-color: var(--color-blanco);
    font-size: 14px;
}

/* Headers de Tabla */
.gestionTablaEventos thead {
    /* Antes var(--color-primario): 3.3:1 con texto blanco */
    background-color: var(--admin-color-primario);
    color: var(--color-blanco);
}

.gestionTablaEventos thead th {
    padding: calc(var(--unidad-espaciado) * 1.5);
    text-align: left;
    font-weight: 600;
    font-size: 13px;
    white-space: nowrap;
}

/* Filas de Datos */
.gestionTablaEventos tbody tr {
    border-bottom: 1px solid var(--color-borde);
    transition: background-color var(--transicion-rapida);
}

.gestionTablaEventos tbody tr:hover {
    background-color: rgba(74, 144, 226, 0.05);
}

.gestionTablaEventos tbody td {
    padding: calc(var(--unidad-espaciado) * 1.5);
    color: var(--color-texto-principal);
    vertical-align: middle;
}

/* Imágenes en Tabla */
.gestionTablaEventos tbody td img {
    max-width: 60px;
    height: auto;
    border-radius: var(--radio-pequeno);
    object-fit: cover;
}

/* Links en Tabla */
.gestionTablaEventos tbody td a {
    color: var(--color-primario);
    text-decoration: none;
    font-weight: 500;
    transition: color var(--transicion-rapida);
}

.gestionTablaEventos tbody td a:hover {
    color: var(--color-primario-oscuro);
    text-decoration: underline;
}

/* Botones en Tabla */
.gestionTablaEventos tbody td .btn-base {
    padding: calc(var(--unidad-espaciado) * 0.75) calc(var(--unidad-espaciado) * 1.5);
    font-size: 12px;
    margin-right: var(--unidad-espaciado);
}

/* Responsive */
@media (max-width: 768px) {
    .gestionCatalogo h1 {
        font-size: 22px;
    }

    .gestionCatalogo > p {
        font-size: 13px;
    }

    .anadirLibrosCatalogo {
        padding: calc(var(--unidad-espaciado) * 2);
        gap: calc(var(--unidad-espaciado) * 1.5);
    }

    .labelFormCatalogo button[type="submit"] {
        height: var(--altura-boton-movil);
    }

    .gestionListado h2 {
        font-size: 18px;
    }

    .gestionTablaEventos thead th {
        padding: var(--unidad-espaciado);
        font-size: 12px;
    }

    .gestionTablaEventos tbody td {
        padding: var(--unidad-espaciado);
        font-size: 13px;
    }

    .gestionTablaEventos tbody td img {
        max-width: 50px;
    }

    .gestionTablaEventos tbody td .btn-base {
        padding: calc(var(--unidad-espaciado) * 0.5) var(--unidad-espaciado);
        font-size: 11px;
        margin-right: calc(var(--unidad-espaciado) * 0.5);
    }
}

@media (max-width: 576px) {
    .gestionCatalogo h1 {
        font-size: 20px;
    }

    .anadirLibrosCatalogo {
        padding: var(--relleno-movil);
        border-left-width: 2px;
    }

    .gestionListado h2 {
        font-size: 16px;
    }

    .gestionTablaBloqueador {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }

    .gestionTablaEventos {
        min-width: 700px;
    }

    .gestionTablaEventos thead th {
        padding: calc(var(--unidad-espaciado) * 0.75);
        font-size: 11px;
    }

    .gestionTablaEventos tbody td {
        padding: calc(var(--unidad-espaciado) * 0.75);
        font-size: 12px;
    }
}
</file>

