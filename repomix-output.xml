   PAGINA: Gestionar Libros Perdidos
   Layout: Formulario de baja + Listado de tarjetas
   Sigue el patron de gestionarUsuarios.css
   ============================================== */

/* --- Contenedor principal de la pagina --- */
.gestionLibrosPerdidos {
    display: flex;
    flex-direction: column;
    background: var(--blanco);
    padding: calc(var(--unidad-espaciado) * 3);
    gap: calc(var(--unidad-espaciado) * 3);
}

/* --- Encabezado superior --- */
